# Copy to .env. Never commit .env.

ASPNETCORE_ENVIRONMENT=Development
CentralDb__Host=localhost
CentralDb__Port=3050
CentralDb__Path=C:/SQLData/SqlAccountSync/SYNC.FDB
# Prefer a least-privilege Firebird user for the app; SYSDBA is shown only as a bootstrap example.
CentralDb__User=SYNC_APP
# Set a strong password in the local .env — never use Firebird's default "masterkey".
CENTRAL_FB_MASTERKEY=REPLACE_WITH_STRONG_PASSWORD
Sync__AllowProductionConnections=false
Sync__AllowCrossEnvironment=false
# Bootstrap__AdminEmail=
