{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "CentralDb": {
    "Host": "localhost",
    "Port": 3050,
    "Path": "",
    "User": "SYSDBA",
    "Charset": "UTF8",
    "Dialect": 3,
    "PasswordSecretRef": "env:CENTRAL_FB_PASSWORD",
    "Pooling": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "PasswordSecretRef": "env:SMTP_PASSWORD",
    "From": "",
    "EnableSsl": true
  },
  "AWS": {
    "Region": "ap-southeast-1"
  },
  "Sync": {
    "SessionHours": 8,
    "OtpMinutes": 10,
    "WorkerPollSeconds": 5,
    "MaxAttempts": 5,
    "AllowProductionConnections": false,
    "AllowCrossEnvironment": false,
    "RequiredTables": [ "ST_ITEM", "AR_CUSTOMER", "SY_USER" ]
  },
  "Bootstrap": {
    "AdminEmail": "admin@localhost",
    "AdminName": "Administrator"
  }
}
