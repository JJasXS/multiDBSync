{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "CentralDb": {
    "Host": "localhost",
    "Port": 3050,
    "Path": "",
    "User": "SYSDBA",
    "Charset": "UTF8",
    "Dialect": 3,
    "PasswordSecretRef": "env:CENTRAL_FB_MASTERKEY",
    "Pooling": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "PasswordSecretRef": "env:SMTP_PASSWORD",
    "From": "",
    "EnableSsl": true
  },
  "AWS": {
    "Region": "ap-southeast-1"
  },
  "Sync": {
    "SessionHours": 8,
    "OtpMinutes": 2,
    "WorkerPollSeconds": 5,
    "AccountAutoPushSeconds": 0,
    "MaxQueueWaitSeconds": 120,
    "AccountAutoUpdateEnabled": true,
    "AccountAutoDeleteEnabled": true,
    "AccountAutoDeleteMaxPerCycle": 25,
    "MaxAttempts": 5,
    "SdkCallTimeoutSeconds": 60,
    "ProcessingLeaseSeconds": 900,
    "AllowProductionConnections": false,
    "AllowCrossEnvironment": false,
    "AppMode": "prod",
    "TenantCode": "TNT10006",
    "SdkSecretId": "",
    "RequiredTables": [ "ST_ITEM", "AR_CUSTOMER", "SY_USER" ]
  },
  "Bootstrap": {
    "AdminEmail": "admin@localhost",
    "AdminName": "Administrator"
  },
  "Features": {
    "ShowMappingsUi": false,
    "ShowSyncConfigUi": false
  }
}
