{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "CentralRegistry": {
    "Mode": "Local",
    "PasswordSecretRef": "env:CENTRAL_FB_MASTERKEY"
  },
  "LogsRemoteRead": {
    "Enabled": false,
    "UseCentralRegistry": true
  },
  "Sync": {
    "AppMode": "dev",
    "AllowLocalOtpReveal": true,
    "OtpMinutes": 2,
    "AllowCrossEnvironment": false,
    "AllowProductionConnections": false,
    "TenantCode": "TNT10006",
    "SdkSecretId": "",
    "AutoAssignSqlApiCredRefByDbId": false,
    "EnsureSqlApiSecretPlaceholder": false,
    "EnableBackgroundWriteWorkers": false,
    "AllowDevSingleJobProcess": true,
    "AccountAutoPushSeconds": 0
  },
  "SqlAccountingWrite": {
    "Provider": "Sdk",
    "BlockRestHttp": true
  },
  "Features": {
    "ForceShowDocumentTransferUi": true
  },
  "SqlAccSdk": {
    "ProgId": "SQLAcc.BizApp",
    "AllowLiveCom": true,
    "DefaultDcfPath": "\\\\192.168.100.201\\Share\\SQLACC.DCF",
    "UserName": "ADMIN",
    "PasswordSecretRef": "env:SQLACC_SDK_PASSWORD",
    "AuthorizeLanRead": true,
    "AuthorizedExactTarget": "\\\\192.168.100.201\\Share\\SQLACC.DCF|ACC-MIRACLE.FDB;\\\\192.168.100.201\\Share\\SQLACC.DCF|ACC-ONYAT.FDB"
  }
}
