@page
@model SqlAccountSync.Pages.Databases.IndexModel
@{
    ViewData["Title"] = "Databases";
    var masters = Model.Databases.Where(d => d.DbRole is "MASTER" or "BOTH").ToList();
    var subs = Model.Databases.Where(d => d.DbRole is "SUB" or "BOTH").ToList();
}
<div class="panel-grid two">
    <div class="card">
        <div class="card-head">
            <h3>Companies</h3>
            @if (Model.IsAdmin)
            {
                <a class="btn small" asp-page="Create">+ Add database</a>
            }
        </div>
        @if (Model.Databases.Count == 0)
        {
            <p class="empty">No companies registered yet.</p>
            <p class="empty-actions">
                @if (Model.IsAdmin)
                {
                    <a class="btn" asp-page="Create">Add database</a>
                }
            </p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Role</th><th>Status</th><th>Last connection</th><th>Last sync</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model.Databases)
                    {
                        <tr>
                            <td><a asp-page="Details" asp-route-id="@d.DbId">@d.DisplayName</a></td>
                            <td><span class="badge badge-@(d.DbRole.ToLowerInvariant())">@d.DbRole</span></td>
                            <td><span class="badge badge-@(d.ConnStatus == "ONLINE" ? "online" : "offline")">@d.ConnStatus</span></td>
                            <td>@(d.LastConnOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>@(d.LastSyncOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-head">
            <h3>Relationships</h3>
            @if (Model.IsAdmin)
            {
                <a class="btn small" asp-page="Link">+ Add relationship</a>
            }
        </div>
        @if (Model.Databases.Count == 0)
        {
            <p class="empty">No companies registered yet. Add at least one Master and one Sub, then create a link.</p>
            <p class="empty-actions">
                <a class="btn" asp-page="Create">Add database</a>
            </p>
        }
        else if (masters.Count == 0 || subs.Count == 0)
        {
            <p class="empty">You need at least one Master and one Sub (or BOTH) before a link can be created.</p>
            <p class="empty-actions">
                <a class="btn" asp-page="Create">Add database</a>
            </p>
        }
        else if (Model.Links.Count == 0)
        {
            <p class="empty">No Master → Sub links yet.</p>
        }
        else
        {
            @foreach (var m in masters)
            {
                <div class="rel-master">
                    <strong>@m.DisplayName</strong>
                    <span class="badge badge-master">MASTER</span>
                    <span class="badge badge-@(m.ConnStatus == "ONLINE" ? "online" : "offline")">@m.ConnStatus</span>
                </div>
                <div class="tree">
                    @foreach (var link in Model.Links.Where(l => l.MasterDbId == m.DbId))
                    {
                        var sub = Model.Databases.FirstOrDefault(d => d.DbId == link.SubDbId);
                        <div class="node">
                            └── SUB @link.SubName
                            @if (sub is not null)
                            {
                                <span class="badge badge-@(sub.ConnStatus == "ONLINE" ? "online" : "offline")">@sub.ConnStatus</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
