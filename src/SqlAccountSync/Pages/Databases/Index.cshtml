@page
@model SqlAccountSync.Pages.Databases.IndexModel
@{
    ViewData["Title"] = "Databases";
    var dbError = TempData["DbError"] as string;
    var dbEditId = TempData["DbEditId"]?.ToString() ?? "";
    string FdbFile(string? path)
    {
        var raw = (path ?? "").Trim().Replace('\\', '/');
        if (raw.Length == 0) return "";
        var i = raw.LastIndexOf('/');
        return i >= 0 ? raw[(i + 1)..] : raw;
    }
}
@if (TempData["DbStatusError"] is string statusError)
{
    <div class="flash flash-err">@statusError</div>
}
<div class="card">
    <div class="card-head">
        <h3>Companies</h3>
        @if (Model.IsAdmin)
        {
            <a class="btn small" asp-page="Create">+ Add database</a>
        }
    </div>
    @if (Model.Databases.Count == 0)
    {
        <p class="empty">No companies registered yet.</p>
        <p class="empty-actions">
            @if (Model.IsAdmin)
            {
                <a class="btn" asp-page="Create">Add database</a>
            }
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th><th>Database</th><th>Role</th><th>Status</th><th>Last connection</th><th>Last sync</th>
                        @if (Model.IsAdmin)
                        {
                            <th class="db-row-delete">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Databases)
                {
                    var fdbName = FdbFile(d.FbPath);
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@d.DbId">@d.DisplayName</a></td>
                        <td class="db-fdb-col" title="@(string.IsNullOrWhiteSpace(d.FbPath) ? null : d.FbPath)">@(string.IsNullOrWhiteSpace(fdbName) ? "—" : @"\" + fdbName)</td>
                        <td><span class="badge badge-@(d.DbRole.ToLowerInvariant())">@d.DbRole</span></td>
                        <td>
                            @{
                                var activeSubCount = Model.Links.Count(l =>
                                    l.MasterDbId == d.DbId
                                    && Model.Databases.Any(s => s.DbId == l.SubDbId && s.IsActive));
                                var isMaster = d.DbRole is DatabaseRoles.Master or DatabaseRoles.Both;
                                var statusSwitch = new ActiveSwitchView
                                {
                                    Id = d.DbId,
                                    Name = d.DisplayName,
                                    IsActive = d.IsActive,
                                    CanToggle = Model.IsAdmin,
                                    ConfirmSubs = Model.IsAdmin && d.IsActive && isMaster && activeSubCount > 0,
                                    ActiveSubCount = activeSubCount
                                };
                            }
                            <partial name="_ActiveSwitch" model="statusSwitch" />
                        </td>
                        <td>@(d.LastConnOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(d.LastSyncOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        @if (Model.IsAdmin)
                        {
                            <td class="db-row-delete">
                                <div class="accounts-row-actions">
                                    @{
                                        Model.SdkByCode.TryGetValue(d.DbCode ?? "", out var sdkCred);
                                        var sdkDb = !string.IsNullOrWhiteSpace(sdkCred?.Database)
                                            ? sdkCred!.Database
                                            : FdbFile(d.FbPath);
                                        var sdkDcf = !string.IsNullOrWhiteSpace(sdkCred?.DcfPath)
                                            ? sdkCred!.DcfPath
                                            : @"C:\eStream\SQLAccounting\Share\SQLACC.DCF";
                                        var sdkUser = !string.IsNullOrWhiteSpace(sdkCred?.Username)
                                            ? sdkCred!.Username
                                            : "ADMIN";
                                    }
                                    <button type="button"
                                            class="accounts-icon-btn accounts-status-edit"
                                            title="Edit @d.DisplayName"
                                            aria-label="Edit @d.DisplayName"
                                            data-db-edit
                                            data-db-id="@d.DbId"
                                            data-code="@d.DbCode"
                                            data-name="@d.DisplayName"
                                            data-role="@d.DbRole"
                                            data-host="@d.FbHost"
                                            data-port="@d.FbPort"
                                            data-path="@d.FbPath"
                                            data-user="@d.FbUser"
                                            data-cred="@d.FbCredRef"
                                            data-charset="@d.FbCharset"
                                            data-dialect="@d.FbDialect"
                                            data-apicred="@d.ApiCredRef"
                                            data-env="@d.Environment"
                                            data-notes="@d.Notes"
                                            data-sdk-user="@sdkUser"
                                            data-sdk-dcf="@sdkDcf"
                                            data-sdk-db="@sdkDb">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                        </svg>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@d.DbId" class="accounts-delete-form">
                                        <button type="submit"
                                                class="accounts-icon-btn accounts-status-delete"
                                                title="Delete @d.DisplayName"
                                                aria-label="Delete @d.DisplayName"
                                                data-confirm="Delete @d.DisplayName? This removes the company from SqlAccountSync and its SDK login from AWS Secrets Manager. The .FDB file stays on disk."
                                                data-confirm-title="Delete company"
                                                data-confirm-ok="Delete"
                                                data-confirm-danger>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
@if (Model.IsAdmin && Model.Databases.Count > 0)
{
    <dialog id="editDatabaseDialog" class="accounts-modal db-create-modal" aria-labelledby="editDatabaseTitle">
        <form method="post" asp-page="Edit" class="accounts-modal-form">
            <input type="hidden" name="ReturnTo" value="list" />
            <input type="hidden" name="Db.DbId" id="editListDbId" />
            <input type="hidden" name="Db.FbCharset" id="editListCharset" />
            <input type="hidden" name="Db.FbDialect" id="editListDialect" />
            <input type="hidden" name="Db.ApiBaseUrl" value="https://api.sql.my" />
            <input type="hidden" name="Db.ApiCredRef" id="editListApiCred" />
            <input type="hidden" name="Db.Environment" id="editListEnv" />
            <input type="hidden" name="Db.Notes" id="editListNotes" />
            <div class="accounts-modal-head">
                <h3 id="editDatabaseTitle">Edit database</h3>
                <button type="button" class="accounts-modal-close" data-edit-database-close aria-label="Close">&times;</button>
            </div>
            <div class="accounts-modal-body">
                @if (!string.IsNullOrWhiteSpace(dbError))
                {
                    <div class="flash flash-err" data-db-error data-db-id="@dbEditId">@dbError</div>
                }
                <div class="db-create-layout">
                    <section class="db-create-sql db-create-panel">
                        <h4>SQL connection</h4>
                        <div class="field-row">
                            <div class="field">
                                <label for="editListHost">Host</label>
                                <input id="editListHost" name="Db.FbHost" required />
                            </div>
                            <div class="field">
                                <label for="editListPort">Port</label>
                                <input id="editListPort" name="Db.FbPort" />
                            </div>
                        </div>
                        <div class="field" data-db-path-group>
                            <label for="editListPath">Database path</label>
                            <div class="path-input">
                                <input id="editListPath" name="Db.FbPath" required data-db-path data-path-kind="fdb" data-sdk-db-source data-find-page="/Databases/Edit" placeholder="C:/SQLAccount/Company.FDB" />
                                <button type="button" class="path-pin" data-db-path-pin aria-label="Choose database file" title="Choose database file">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                                </button>
                                <input type="file" data-db-path-file accept=".fdb,.gdb" hidden />
                            </div>
                            <p class="field-hint" data-db-path-hint>Use the pin to choose the company .FDB.</p>
                        </div>
                        @if (Model.IsSdkMode)
                        {
                            <input type="hidden" id="editListUser" name="Db.FbUser" value="SYSDBA" />
                            <input type="hidden" id="editListKey" name="Db.FbCredRef" value="masterkey" />
                            <p class="field-hint">SDK Live mode: Firebird SYSDBA/master key stay as defaults (used for reads only).</p>
                        }
                        else
                        {
                            <div class="field-row">
                                <div class="field">
                                    <label for="editListUser">User</label>
                                    <input id="editListUser" name="Db.FbUser" />
                                </div>
                                <div class="field">
                                    <label for="editListKey">Master key reference</label>
                                    <input id="editListKey" name="Db.FbCredRef" type="password" autocomplete="off" required />
                                </div>
                            </div>
                        }
                    </section>
                    <div class="db-create-side db-create-panel">
                        <h4>Company</h4>
                        <div class="field">
                            <label for="editListCode">Code</label>
                            <input id="editListCode" name="Db.DbCode" required />
                        </div>
                        <div class="field">
                            <label for="editListName">Name</label>
                            <input id="editListName" name="Db.DisplayName" required />
                        </div>
                        <div class="field">
                            <span class="field-caption" id="editListRole">Role</span>
                            <div class="role-radios" role="radiogroup" aria-labelledby="editListRole">
                                <label class="role-choice"><input type="radio" name="Db.DbRole" value="MASTER" data-role-master /> Master</label>
                                <label class="role-choice"><input type="radio" name="Db.DbRole" value="SUB" data-role-sub /> Sub</label>
                            </div>
                        </div>
                        @{ ViewData["WriteCredIdPrefix"] = "editList"; }
                        <partial name="_WriteCredFields" />
                    </div>
                </div>
            </div>
            <div class="accounts-modal-actions">
                <button type="button" class="btn btn-ghost" data-edit-database-close>Cancel</button>
                <button class="btn" type="submit">Save</button>
            </div>
        </form>
    </dialog>
    <dialog id="dbPathMatches" class="accounts-modal db-path-modal" aria-labelledby="dbPathMatchesTitle">
        <div class="accounts-modal-form">
            <div class="accounts-modal-head">
                <h3 id="dbPathMatchesTitle">Choose a file</h3>
                <button type="button" class="accounts-modal-close" data-db-path-close aria-label="Close">&times;</button>
            </div>
            <div class="accounts-modal-body">
                <p class="field-hint" data-db-path-folder>Pick the path to use.</p>
                <ul class="db-path-list" data-db-path-matches></ul>
                <button type="button" class="btn secondary db-path-os" data-db-path-os>Open file explorer…</button>
            </div>
        </div>
    </dialog>
    <script src="~/js/db-path-browse.js" asp-append-version="true"></script>
    <script>
        function setEditValue(id, value) {
            const el = document.getElementById(id);
            if (el) el.value = value || "";
        }
        function openEditDatabase(btn) {
            setEditValue("editListDbId", btn.getAttribute("data-db-id"));
            setEditValue("editListCharset", btn.getAttribute("data-charset"));
            setEditValue("editListDialect", btn.getAttribute("data-dialect"));
            setEditValue("editListApiCred", btn.getAttribute("data-apicred"));
            setEditValue("editListEnv", btn.getAttribute("data-env"));
            setEditValue("editListNotes", btn.getAttribute("data-notes"));
            setEditValue("editListHost", btn.getAttribute("data-host"));
            setEditValue("editListPort", btn.getAttribute("data-port"));
            setEditValue("editListPath", btn.getAttribute("data-path"));
            setEditValue("editListUser", btn.getAttribute("data-user") || "SYSDBA");
            setEditValue("editListKey", btn.getAttribute("data-cred") || "masterkey");
            setEditValue("editListCode", btn.getAttribute("data-code"));
            setEditValue("editListName", btn.getAttribute("data-name"));
            setEditValue("editListAccess", "");
            setEditValue("editListSecret", "");
            setEditValue("editListSdkUser", btn.getAttribute("data-sdk-user") || "ADMIN");
            setEditValue("editListSdkPass", "");
            setEditValue("editListSdkDcf", btn.getAttribute("data-sdk-dcf") || "C:\\eStream\\SQLAccounting\\Share\\SQLACC.DCF");
            const sdkDb = btn.getAttribute("data-sdk-db") || fileNameFromPath(btn.getAttribute("data-path"));
            setEditValue("editListSdkDb", sdkDb);
            const path = document.getElementById("editListPath");
            if (path) path.setAttribute("data-find-page", "/Databases/Edit/" + (btn.getAttribute("data-db-id") || ""));
            const isSub = (btn.getAttribute("data-role") || "").toUpperCase() === "SUB";
            const master = document.querySelector("[data-role-master]");
            const sub = document.querySelector("[data-role-sub]");
            if (master) master.checked = !isSub;
            if (sub) sub.checked = isSub;
            const dialog = document.getElementById("editDatabaseDialog");
            if (dialog && typeof dialog.showModal === "function" && !dialog.open) dialog.showModal();
        }
        function fileNameFromPath(path) {
            const raw = (path || "").trim().replace(/\\/g, "/");
            if (!raw) return "";
            const parts = raw.split("/");
            return parts[parts.length - 1] || "";
        }
        document.querySelectorAll("[data-db-edit]").forEach((btn) => {
            btn.addEventListener("click", () => openEditDatabase(btn));
        });
        document.querySelectorAll("[data-edit-database-close]").forEach((btn) => {
            btn.addEventListener("click", () => document.getElementById("editDatabaseDialog")?.close());
        });
        const dbError = document.querySelector("[data-db-error]");
        if (dbError) {
            const again = document.querySelector('[data-db-edit][data-db-id="' + dbError.getAttribute("data-db-id") + '"]');
            if (again) openEditDatabase(again);
        }
    </script>
}
