@using SqlAccountSync.Options
@using SqlAccountSync.Services.Sync
@inject IWriteProviderSettings WriteProvider
@{
    var idPrefix = (string?)ViewData["WriteCredIdPrefix"] ?? "cred";
    var mode = await WriteProvider.GetAsync();
    var isSdk = SqlAccountingWriteProviders.IsSdk(mode);
    var sdkUser = (ViewData["SdkUsername"] as string)?.Trim();
    if (string.IsNullOrWhiteSpace(sdkUser)) sdkUser = "ADMIN";
    var sdkDcf = (ViewData["SdkDcfPath"] as string)?.Trim();
    if (string.IsNullOrWhiteSpace(sdkDcf)) sdkDcf = @"C:\eStream\SQLAccounting\Share\SQLACC.DCF";
    var sdkDb = (ViewData["SdkDatabase"] as string)?.Trim() ?? "";
}
<input type="hidden" name="WriteMode" value="@(isSdk ? "Sdk" : "Rest")" />
@if (isSdk)
{
    <h4 class="db-create-subhead">SDK Live</h4>
    <div class="field">
        <label for="@(idPrefix)SdkUser">User</label>
        <input id="@(idPrefix)SdkUser" name="SdkUsername" value="@sdkUser" autocomplete="off" />
    </div>
    <div class="field">
        <label for="@(idPrefix)SdkPass">Password</label>
        <input id="@(idPrefix)SdkPass" name="SdkPassword" type="password" autocomplete="new-password" placeholder="Leave blank to keep existing" />
    </div>
    <div class="field" data-db-path-group>
        <label for="@(idPrefix)SdkDcf">DCF path (.DCF)</label>
        <div class="path-input">
            <input id="@(idPrefix)SdkDcf" name="SdkDcfPath" data-db-path data-path-kind="dcf" value="@sdkDcf" placeholder="C:/eStream/SQLAccounting/Share/SQLACC.DCF" />
            <button type="button" class="path-pin" data-db-path-pin aria-label="Choose .DCF file" title="Choose .DCF file">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
            </button>
            <input type="file" data-db-path-file accept=".dcf" hidden />
        </div>
        <p class="field-hint" data-db-path-hint>Use the pin to choose the SQL Account .DCF (not the .FDB).</p>
    </div>
    <div class="field">
        <label for="@(idPrefix)SdkDb">Company database name</label>
        <input id="@(idPrefix)SdkDb" name="SdkDatabase" value="@sdkDb" data-sdk-db-target placeholder="ACC-MAIN.FDB" />
        <p class="field-hint">FDB file name inside the DCF (filled from Database path when empty).</p>
    </div>
}
else
{
    <h4 class="db-create-subhead">SQL API</h4>
    <div class="field">
        <label for="@(idPrefix)ApiAccess">Access key</label>
        <input id="@(idPrefix)ApiAccess" name="ApiAccessKey" autocomplete="off" />
    </div>
    <div class="field">
        <label for="@(idPrefix)ApiSecret">Secret key</label>
        <input id="@(idPrefix)ApiSecret" name="ApiSecretKey" type="password" autocomplete="new-password" />
    </div>
}
