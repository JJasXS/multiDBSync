@using SqlAccountSync.Options
@using SqlAccountSync.Services.Sync
@inject IWriteProviderSettings WriteProvider
@{
    var idPrefix = (string?)ViewData["WriteCredIdPrefix"] ?? "cred";
    var mode = await WriteProvider.GetAsync();
    var isSdk = SqlAccountingWriteProviders.IsSdk(mode);
}
<input type="hidden" name="WriteMode" value="@(isSdk ? "Sdk" : "Rest")" />
<input type="hidden" name="SdkDcfPath" value="C:\eStream\SQLAccounting\Share\SQLACC.DCF" />
@if (isSdk)
{
    <h4 class="db-create-subhead">SDK Live</h4>
    <div class="field">
        <label for="@(idPrefix)SdkUser">User</label>
        <input id="@(idPrefix)SdkUser" name="SdkUsername" value="ADMIN" autocomplete="off" />
    </div>
    <div class="field">
        <label for="@(idPrefix)SdkPass">Password</label>
        <input id="@(idPrefix)SdkPass" name="SdkPassword" type="password" autocomplete="new-password" placeholder="Required for new" />
    </div>
    <div class="field">
        <label for="@(idPrefix)SdkDb">Database file</label>
        <input id="@(idPrefix)SdkDb" name="SdkDatabase" placeholder="ACC-COMPANY.FDB" />
    </div>
}
else
{
    <h4 class="db-create-subhead">SQL API</h4>
    <div class="field">
        <label for="@(idPrefix)ApiAccess">Access key</label>
        <input id="@(idPrefix)ApiAccess" name="ApiAccessKey" autocomplete="off" />
    </div>
    <div class="field">
        <label for="@(idPrefix)ApiSecret">Secret key</label>
        <input id="@(idPrefix)ApiSecret" name="ApiSecretKey" type="password" autocomplete="new-password" />
    </div>
}
