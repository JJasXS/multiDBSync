@page "{id:int?}"
@model SqlAccountSync.Pages.Databases.EditModel
@{
    ViewData["Title"] = Model.Db.DbId == 0 ? "Add database" : "Edit database";
}
<form method="post">
    <input type="hidden" asp-for="Db.DbId" />
    <div class="panel-grid">
        <div class="card">
            <div class="card-head">
                <h3>Identity</h3>
            </div>
            <p class="muted lede">How this company appears in the console, and whether it is Master, Sub, or both.</p>
            <div class="form-stack">
                <div>
                    <label>Code</label>
                    <input asp-for="Db.DbCode" required placeholder="HQ01" />
                </div>
                <div>
                    <label>Display name</label>
                    <input asp-for="Db.DisplayName" required placeholder="Headquarters" />
                </div>
                <div>
                    <label>Company name</label>
                    <input asp-for="Db.CompanyName" placeholder="As shown in SQL Account" />
                </div>
                <div>
                    <label>Role</label>
                    <select asp-for="Db.DbRole">
                        <option>MASTER</option>
                        <option>SUB</option>
                        <option>BOTH</option>
                    </select>
                </div>
                <div>
                    <label>Environment</label>
                    <select asp-for="Db.Environment">
                        <option>DEVELOPMENT</option>
                        <option>TESTING</option>
                        <option>PRODUCTION</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h3>Firebird connection</h3>
            </div>
            <p class="muted lede">Read-only access to the company file. Store a secret reference, never a password.</p>
            <div class="form-stack">
                <div class="field-pair">
                    <div>
                        <label>Host</label>
                        <input asp-for="Db.FbHost" required placeholder="localhost" />
                    </div>
                    <div>
                        <label>Port</label>
                        <input asp-for="Db.FbPort" />
                    </div>
                </div>
                <div>
                    <label>Database path</label>
                    <input asp-for="Db.FbPath" required placeholder="C:/SQLAccount/Company.FDB" />
                </div>
                <div class="field-pair">
                    <div>
                        <label>User</label>
                        <input asp-for="Db.FbUser" placeholder="SYSDBA" />
                    </div>
                    <div>
                        <label>Charset</label>
                        <input asp-for="Db.FbCharset" placeholder="UTF8" />
                    </div>
                </div>
                <div>
                    <label>Dialect</label>
                    <input asp-for="Db.FbDialect" />
                </div>
                <div>
                    <label>Password secret reference</label>
                    <input asp-for="Db.FbCredRef" placeholder="env:COMPANY_A_FB_PASSWORD" required />
                    <p class="field-hint">Use <code>env:</code>, <code>sm:</code>, or <code>dpapi:</code>.</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h3>SQL Accounting API</h3>
            </div>
            <p class="muted lede">Optional. Needed only when this company will receive writes.</p>
            <div class="form-stack">
                <div>
                    <label>API base URL</label>
                    <input asp-for="Db.ApiBaseUrl" placeholder="https://api.sql.my" />
                </div>
                <div>
                    <label>API credential reference</label>
                    <input asp-for="Db.ApiCredRef" placeholder="sm:sql-api-hq01" />
                </div>
                <div>
                    <label>Notes</label>
                    <textarea asp-for="Db.Notes" rows="4" placeholder="Internal remarks"></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="form-bar">
        <button class="btn" type="submit">Save</button>
        <a class="btn secondary" asp-page="Index">Cancel</a>
    </div>
</form>
