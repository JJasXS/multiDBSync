@page "{id:int?}"
@model SqlAccountSync.Pages.Databases.EditModel
@{
    ViewData["Title"] = Model.Db.DbId == 0 ? "Add database" : "Edit database";
}
<form method="post">
    <input type="hidden" asp-for="Db.DbId" />
    <div class="panel-grid db-edit-grid">
        <div class="card">
            <div class="card-head">
                <h3>Identity</h3>
            </div>
            <p class="muted lede">How this company appears in the console, and whether it is Master, Sub, or both.</p>
            <div class="form-stack">
                <div>
                    <label>Code</label>
                    <input asp-for="Db.DbCode" required placeholder="HQ01"
                           data-db-code
                           data-tenant-code="@Model.TenantCode"
                           data-sync-api-cred="@(Model.AutoSqlApiCredRef ? "true" : "false")" />
                </div>
                <div>
                    <label>Name</label>
                    <input asp-for="Db.DisplayName" required placeholder="Headquarters" />
                </div>
                <div>
                    <label>Role</label>
                    <select asp-for="Db.DbRole">
                        <option>MASTER</option>
                        <option>SUB</option>
                        <option>BOTH</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h3>Firebird connection</h3>
            </div>
            <p class="muted lede">Read-only access to the company file. Store a secret reference, never a password.</p>
            <div class="form-stack">
                <div class="field-pair equal">
                    <div>
                        <label>Host</label>
                        <input asp-for="Db.FbHost" required placeholder="localhost" />
                    </div>
                    <div>
                        <label>Port</label>
                        <input asp-for="Db.FbPort" />
                    </div>
                </div>
                <div>
                    <label>Database path</label>
                    <div class="path-input">
                        <input asp-for="Db.FbPath" required placeholder="C:/SQLAccount/Company.FDB" data-db-path />
                        <button type="button" class="path-pin" data-db-path-pin aria-label="Choose database file" title="Choose database file">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                        </button>
                        <input type="file" data-db-path-file accept=".fdb,.gdb" hidden />
                    </div>
                    <p class="field-hint" data-db-path-hint>Use the pin to open the file picker and choose the company .FDB. The path is filled in for you.</p>
                </div>
                <input type="hidden" asp-for="Db.FbCharset" />
                <input type="hidden" asp-for="Db.FbDialect" />
                <div class="field-pair equal">
                    <div>
                        <label>User</label>
                        <input asp-for="Db.FbUser" placeholder="SYSDBA" />
                    </div>
                    <div>
                        <label>Master key reference</label>
                        <div class="secret-input">
                            <input asp-for="Db.FbCredRef" type="password" autocomplete="off" placeholder="masterkey" required />
                            <button type="button" class="secret-toggle" data-secret-toggle aria-label="Show secret reference" title="Show / hide">
                                <svg class="icon-eye" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" hidden><path fill="currentColor" d="M2 4.3 3.3 3l18 18-1.3 1.3-3.1-3.1A12.5 12.5 0 0 1 12 19C5 19 2 12 2 12a21.4 21.4 0 0 1 5.2-5.9L2 4.3zM12 7a5 5 0 0 1 5 5c0 .7-.1 1.3-.4 1.9l-1.6-1.6A3 3 0 0 0 12 9c-.3 0-.5 0-.8.1L9.4 7.3C10.2 7.1 11.1 7 12 7zm-5 5c0-.5.1-1 .2-1.4l6.2 6.2c-.4.1-.9.2-1.4.2a5 5 0 0 1-5-5zm13.8 2.5-2.5-2.5.9-.9A21 21 0 0 0 22 12s-3-7-10-7c-1.2 0-2.3.2-3.3.5L7.2 4A13.6 13.6 0 0 1 12 3c7 0 10 7 10 7a23 23 0 0 1-1.2 4.5z"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h3>SQL Accounting API</h3>
            </div>
            <p class="muted lede">Optional. Needed only when this company will receive writes.</p>
            <div class="form-stack">
                <div>
                    <label>API base URL</label>
                    <input asp-for="Db.ApiBaseUrl" value="@Model.DefaultApiBaseUrl" readonly />
                </div>
                <div>
                    <label>API credential reference</label>
                    <div class="copy-input">
                        <input asp-for="Db.ApiCredRef" data-api-cred-ref
                               placeholder="@Model.SqlApiCredRefPlaceholder" />
                        <button type="button" class="copy-toggle" data-copy-field aria-label="Copy credential reference" title="Copy">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                        </button>
                    </div>
                    <p class="field-hint">@Model.SqlApiCredRefHint</p>
                </div>
            </div>
        </div>
    </div>
    <div class="card db-edit-notes">
        <label>Notes</label>
        <textarea asp-for="Db.Notes" rows="3" placeholder="Internal remarks"></textarea>
    </div>
    <div class="form-bar">
        <button class="btn" type="submit">Save</button>
        <a class="btn secondary" asp-page="Index">Cancel</a>
    </div>
</form>
<dialog id="dbPathMatches" class="accounts-modal db-path-modal" aria-labelledby="dbPathMatchesTitle">
    <div class="accounts-modal-form">
        <div class="accounts-modal-head">
            <h3 id="dbPathMatchesTitle">Choose a path</h3>
            <button type="button" class="accounts-modal-close" data-db-path-close aria-label="Close">&times;</button>
        </div>
        <div class="accounts-modal-body">
            <p class="field-hint">More than one file has that name. Pick the path to use.</p>
            <ul class="db-path-list" data-db-path-matches></ul>
        </div>
    </div>
</dialog>
<script src="~/js/db-path-browse.js" asp-append-version="true"></script>
