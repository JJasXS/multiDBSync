@page "{id:int}"
@model SqlAccountSync.Pages.Databases.DetailsModel
@using Microsoft.Extensions.Options
@using SqlAccountSync.Options
@inject IOptions<FeatureOptions> FeatureOptions
@inject SqlAccountSync.Services.Tenants.TenantMenuFlags MenuFlags
@{
    ViewData["Title"] = Model.Db?.DisplayName ?? "Database";
    var d = Model.Db!;
    var showMappingsUi = FeatureOptions.Value.ShowMappingsUi;
    var online = d.ConnStatus == "ONLINE";
    var isMaster = d.DbRole is DatabaseRoles.Master or DatabaseRoles.Both;
    var statusSwitch = new ActiveSwitchView
    {
        Id = d.DbId,
        Name = d.DisplayName,
        IsActive = d.IsActive,
        CanToggle = Model.IsAdmin,
        ConfirmSubs = Model.IsAdmin && d.IsActive && isMaster && Model.ActiveSubCount > 0,
        ActiveSubCount = Model.ActiveSubCount,
        FormPage = "/Databases/Index"
    };
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="flash @(Model.LastTest?.Success == true ? "flash-ok" : "flash-err")">@Model.Message</div>
}
<div class="card db-detail">
    <div class="db-detail-top">
        <div class="db-detail-status">
            <span class="badge badge-@(d.DbRole.ToLowerInvariant())">@d.DbRole</span>
            <span class="badge badge-@(online ? "online" : "offline")">@d.ConnStatus</span>
            <partial name="_ActiveSwitch" model="statusSwitch" />
        </div>
        <details class="kebab">
            <summary aria-label="Actions">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
            </summary>
            <div class="kebab-menu">
                <form method="post" asp-page-handler="Test">
                    <button type="submit">Test connection</button>
                </form>
                @if (Model.IsAdmin)
                {
                    <button type="button" id="openEditDatabase">Edit</button>
                }
                @if (MenuFlags.ShowDocumentTransfer)
                {
                    <a asp-page="/Transactions/Index">Document transfer</a>
                }
                <a asp-page="/Logs">View logs</a>
                @if (showMappingsUi)
                {
                    <a asp-page="/Mappings/Index" asp-route-entity="ITEM">View mappings</a>
                }
            </div>
        </details>
    </div>
    @if (!string.IsNullOrWhiteSpace(d.CompanyName)
        && !string.Equals(d.CompanyName.Trim(), d.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase))
    {
        <p class="db-detail-company">@d.CompanyName</p>
    }
    <dl class="db-detail-facts">
        <div><dt>Host</dt><dd>@d.FbHost</dd></div>
        <div><dt>Port</dt><dd>@d.FbPort</dd></div>
        <div><dt>User</dt><dd>@d.FbUser</dd></div>
        <div><dt>Last connection</dt><dd>@(d.LastConnOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
        <div><dt>Last sync</dt><dd>@(d.LastSyncOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
    </dl>
</div>
@if (Model.IsAdmin)
{
    var dbError = TempData["DbError"] as string;
    var roleIsSub = string.Equals(d.DbRole, DatabaseRoles.Sub, StringComparison.OrdinalIgnoreCase);
    <dialog id="editDatabaseDialog" class="accounts-modal db-create-modal" aria-labelledby="editDatabaseTitle">
        <form method="post" asp-page="Edit" asp-route-id="@d.DbId" class="accounts-modal-form">
            <input type="hidden" name="ReturnTo" value="details" />
            <input type="hidden" name="Db.DbId" value="@d.DbId" />
            <input type="hidden" name="Db.FbCharset" value="@d.FbCharset" />
            <input type="hidden" name="Db.FbDialect" value="@d.FbDialect" />
            <input type="hidden" name="Db.ApiBaseUrl" value="https://api.sql.my" />
            <input type="hidden" name="Db.ApiCredRef" value="@d.ApiCredRef" />
            <input type="hidden" name="Db.Environment" value="@d.Environment" />
            <input type="hidden" name="Db.Notes" value="@d.Notes" />
            <div class="accounts-modal-head">
                <h3 id="editDatabaseTitle">Edit database</h3>
                <button type="button" class="accounts-modal-close" data-edit-database-close aria-label="Close">&times;</button>
            </div>
            <div class="accounts-modal-body">
                @if (!string.IsNullOrWhiteSpace(dbError))
                {
                    <div class="flash flash-err" data-db-error>@dbError</div>
                }
                <div class="db-create-layout">
                    <section class="db-create-sql db-create-panel">
                        <h4>SQL connection</h4>
                        <div class="field-row">
                            <div class="field">
                                <label for="editDbHost">Host</label>
                                <input id="editDbHost" name="Db.FbHost" required value="@d.FbHost" />
                            </div>
                            <div class="field">
                                <label for="editDbPort">Port</label>
                                <input id="editDbPort" name="Db.FbPort" value="@d.FbPort" />
                            </div>
                        </div>
                        <div class="field">
                            <label for="editDbPath">Database path</label>
                            <div class="path-input">
                                <input id="editDbPath" name="Db.FbPath" required value="@d.FbPath" data-db-path data-find-page="/Databases/Edit/@d.DbId" />
                                <button type="button" class="path-pin" data-db-path-pin aria-label="Choose database file" title="Choose database file">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
                                </button>
                                <input type="file" data-db-path-file accept=".fdb,.gdb" hidden />
                            </div>
                            <p class="field-hint" data-db-path-hint>Use the pin to choose the company .FDB.</p>
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label for="editDbUser">User</label>
                                <input id="editDbUser" name="Db.FbUser" value="@d.FbUser" />
                            </div>
                            <div class="field">
                                <label for="editDbKey">Master key reference</label>
                                <input id="editDbKey" name="Db.FbCredRef" type="password" autocomplete="off" value="@d.FbCredRef" required />
                            </div>
                        </div>
                    </section>
                    <div class="db-create-side db-create-panel">
                        <h4>Company</h4>
                        <div class="field">
                            <label for="editDbCode">Code</label>
                            <input id="editDbCode" name="Db.DbCode" required value="@d.DbCode" />
                        </div>
                        <div class="field">
                            <label for="editDbName">Name</label>
                            <input id="editDbName" name="Db.DisplayName" required value="@d.DisplayName" />
                        </div>
                        <div class="field">
                            <span class="field-caption" id="editDbRole">Role</span>
                            <div class="role-radios" role="radiogroup" aria-labelledby="editDbRole">
                                <label class="role-choice"><input type="radio" name="Db.DbRole" value="MASTER" @(roleIsSub ? null : "checked") /> Master</label>
                                <label class="role-choice"><input type="radio" name="Db.DbRole" value="SUB" @(roleIsSub ? "checked" : null) /> Sub</label>
                            </div>
                        </div>
                        @{ ViewData["WriteCredIdPrefix"] = "editDb"; }
                        <partial name="_WriteCredFields" />
                    </div>
                </div>
            </div>
            <div class="accounts-modal-actions">
                <button type="button" class="btn btn-ghost" data-edit-database-close>Cancel</button>
                <button class="btn" type="submit">Save</button>
            </div>
        </form>
    </dialog>
    <dialog id="dbPathMatches" class="accounts-modal db-path-modal" aria-labelledby="dbPathMatchesTitle">
        <div class="accounts-modal-form">
            <div class="accounts-modal-head">
                <h3 id="dbPathMatchesTitle">Choose a path</h3>
                <button type="button" class="accounts-modal-close" data-db-path-close aria-label="Close">&times;</button>
            </div>
            <div class="accounts-modal-body">
                <p class="field-hint">More than one file has that name. Pick the path to use.</p>
                <ul class="db-path-list" data-db-path-matches></ul>
            </div>
        </div>
    </dialog>
    <script src="~/js/db-path-browse.js" asp-append-version="true"></script>
    <script>
        function openEditDatabase() {
            document.getElementById("openEditDatabase")?.closest("details.kebab")?.removeAttribute("open");
            const dialog = document.getElementById("editDatabaseDialog");
            if (dialog && typeof dialog.showModal === "function" && !dialog.open) dialog.showModal();
        }
        document.getElementById("openEditDatabase")?.addEventListener("click", openEditDatabase);
        document.querySelectorAll("[data-edit-database-close]").forEach((btn) => {
            btn.addEventListener("click", () => document.getElementById("editDatabaseDialog")?.close());
        });
        if (document.querySelector("[data-db-error]")) openEditDatabase();
    </script>
}
