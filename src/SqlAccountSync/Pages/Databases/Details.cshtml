@page "{id:int}"
@model SqlAccountSync.Pages.Databases.DetailsModel
@using Microsoft.Extensions.Options
@using SqlAccountSync.Options
@inject IOptions<FeatureOptions> FeatureOptions
@{
    ViewData["Title"] = Model.Db?.DisplayName ?? "Database";
    var d = Model.Db!;
    var showMappingsUi = FeatureOptions.Value.ShowMappingsUi;
    var online = d.ConnStatus == "ONLINE";
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="flash @(Model.LastTest?.Success == true ? "flash-ok" : "flash-err")">@Model.Message</div>
}
<div class="card db-detail">
    <div class="db-detail-top">
        <div class="db-detail-status">
            <span class="badge badge-@(d.DbRole.ToLowerInvariant())">@d.DbRole</span>
            <span class="badge badge-@(online ? "online" : "offline")">@d.ConnStatus</span>
        </div>
        <details class="kebab">
            <summary aria-label="Actions">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
            </summary>
            <div class="kebab-menu">
                <form method="post" asp-page-handler="Test">
                    <button type="submit">Test connection</button>
                </form>
                @if (Model.IsAdmin)
                {
                    <a asp-page="Edit" asp-route-id="@d.DbId">Edit</a>
                }
                <a asp-page="/Transactions/Index">Document transfer</a>
                <a asp-page="/Logs">View logs</a>
                <a asp-page="/Push/Index" asp-route-tab="jobs">Sync now</a>
                @if (showMappingsUi)
                {
                    <a asp-page="/Mappings/Index" asp-route-entity="ITEM">View mappings</a>
                }
                @if (Model.IsAdmin)
                {
                    <form method="post" asp-page-handler="Disable"
                          data-confirm="Disable this database? History is kept."
                          data-confirm-title="Disable database"
                          data-confirm-ok="Disable"
                          data-confirm-danger>
                        <button class="kebab-danger" type="submit">Disable database</button>
                    </form>
                }
            </div>
        </details>
    </div>
    @if (!string.IsNullOrWhiteSpace(d.CompanyName)
        && !string.Equals(d.CompanyName.Trim(), d.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase))
    {
        <p class="db-detail-company">@d.CompanyName</p>
    }
    <dl class="db-detail-facts">
        <div><dt>Host</dt><dd>@d.FbHost</dd></div>
        <div><dt>Port</dt><dd>@d.FbPort</dd></div>
        <div><dt>User</dt><dd>@d.FbUser</dd></div>
        <div><dt>Last connection</dt><dd>@(d.LastConnOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
        <div><dt>Last sync</dt><dd>@(d.LastSyncOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
    </dl>
</div>
