@page
@model SqlAccountSync.Pages.Browse.IndexModel
@{
    ViewData["Title"] = "Browse (read-only)";
}
<div class="card">
    <p class="muted">SQL Account data is read through a Firebird read-only transaction. Nothing on this page can write to a company database.</p>
    <form method="get" class="form-grid">
        <div>
            <label>Database</label>
            <select name="dbId">
                @foreach (var d in Model.Databases) { <option value="@d.DbId" selected="@(d.DbId == Model.DbId)">@d.DisplayName</option> }
            </select>
        </div>
        <div>
            <label>Entity</label>
            <select name="entity">
                @foreach (var e in new[] { "ITEM", "CUSTOMER", "SUPPLIER", "WAREHOUSE", "TAXCODE", "ACCOUNT", "UOM" })
                {
                    <option value="@e" selected="@(e == Model.Entity)">@e</option>
                }
            </select>
        </div>
        <div><button class="btn" type="submit">Load</button></div>
        <div><button class="btn secondary" type="submit" name="discover" value="true">Discover schema</button></div>
    </form>
</div>
<div class="card">
    <table>
        <thead><tr><th>Code</th><th>Description</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Records)
        {
            <tr><td>@r.Code</td><td>@r.Description</td></tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Schema is not null)
{
    <div class="card">
        <h3>Schema discovery</h3>
        <p>Entity table hints:</p>
        <ul>
            @foreach (var kv in Model.Schema.EntityTableHints)
            {
                <li>@kv.Key → @kv.Value</li>
            }
        </ul>
        <p class="muted">@Model.Schema.Tables.Count tables found. Unverified entities are hinted only when a matching table exists.</p>
    </div>
}
