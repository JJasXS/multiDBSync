@model SoListingDetails
<section class="card txn-summary so-listing" data-so-summary data-so-status="@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "loading" : "error")">
    <div class="card-head">
        <h3>SO Listing &amp; Occupancy</h3>
    </div>
    <form method="get" asp-page="/Reports/SoListing" class="txn-summary-filters" data-so-filters>
        <div class="txn-filter so-filter-company">
            <label for="soCompany">Company</label>
            <select id="soCompany" name="companyId" data-so-company>
                @if (Model.CompanyId > 0 && !Model.Companies.Any(company => company.DbId == Model.CompanyId))
                {
                    <option value="@Model.CompanyId" selected>Selected company is unavailable</option>
                }
                <option value="" selected="@(Model.CompanyId <= 0 ? "selected" : null)">All Companies</option>
                @foreach (var company in Model.Companies)
                {
                    <option value="@company.DbId"
                            selected="@(company.DbId == Model.CompanyId ? "selected" : null)">
                        @company.Label
                    </option>
                }
            </select>
        </div>
        <div class="so-filter-warning" data-so-warning aria-live="polite" title="Load warnings"></div>
        <div class="txn-filter-actions">
            <button type="button"
                    class="btn secondary report-refresh-btn"
                    data-so-refresh
                    title="Refresh data"
                    aria-label="Refresh data">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                          d="M20 12a8 8 0 1 1-2.2-5.5M20 4v5h-5"/>
                </svg>
            </button>
            <button type="button" class="btn secondary" data-so-export-all>Export to Excel</button>
        </div>
    </form>
    <div class="table-wrap txn-summary-scroll">
        <div data-so-results>
            @if (Model.DatabaseAvailable)
            {
                <partial name="_SoListingResults" model="Model" />
            }
        </div>
        <p class="empty txn-summary-status" data-so-panel="loading" hidden>Loading...</p>
        <p class="empty txn-summary-status" data-so-panel="error" hidden>@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "SO listing data could not be loaded." : Model.ErrorMessage)</p>
    </div>
    <script>
        (() => {
            const root = document.querySelector("[data-so-summary]");
            if (!root) return;

            const filters = root.querySelector("[data-so-filters]");
            const results = root.querySelector("[data-so-results]");
            const warningHost = root.querySelector("[data-so-warning]");
            let requestSeq = 0;

            const panels = () => root.querySelectorAll("[data-so-panel]");

            const applyStatus = (status) => {
                panels().forEach((panel) => {
                    panel.hidden = panel.getAttribute("data-so-panel") !== status;
                });
            };

            const parkWarning = () => {
                if (!warningHost || !results) return;
                warningHost.replaceChildren();
                const slot = results.querySelector(".report-load-warning-slot");
                if (slot) warningHost.appendChild(slot);
            };

            const syncHeaderOffset = () => {
                const table = root.querySelector(".so-matrix");
                const firstRow = table?.querySelector("thead tr:first-child");
                if (!table || !firstRow) return;
                const height = Math.round(firstRow.getBoundingClientRect().height);
                if (height > 0)
                    table.style.setProperty("--so-head-1", `${height}px`);
            };

            const rememberFilters = () => {
                if (!filters) return;
                const pageQuery = new URLSearchParams(new FormData(filters));
                const pageUrl = new URL(filters.getAttribute("action"), window.location.href);
                pageUrl.search = pageQuery.toString();
                history.replaceState(null, "", pageUrl);
            };

            const refreshDetails = async () => {
                if (!filters || !results) return;
                const seq = ++requestSeq;
                applyStatus("loading");
                root.setAttribute("aria-busy", "true");
                const query = new URLSearchParams(new FormData(filters));
                query.set("handler", "Details");
                rememberFilters();
                try {
                    const response = await fetch(`${filters.getAttribute("action")}?${query}`, {
                        headers: { "X-Requested-With": "fetch" }
                    });
                    if (seq !== requestSeq) return;
                    if (!response.ok) {
                        const message = (await response.text()).trim();
                        const errorPanel = root.querySelector("[data-so-panel='error']");
                        if (errorPanel && message && !message.startsWith("<"))
                            errorPanel.textContent = message;
                        throw new Error(String(response.status));
                    }
                    results.innerHTML = await response.text();
                    parkWarning();
                    applyStatus("ready");
                    syncHeaderOffset();
                    root.removeAttribute("aria-busy");
                } catch {
                    if (seq !== requestSeq) return;
                    if (warningHost) warningHost.replaceChildren();
                    applyStatus("error");
                    root.removeAttribute("aria-busy");
                }
            };

            const downloadReport = (params) => {
                if (!filters) return;
                const url = new URL(filters.getAttribute("action"), window.location.href);
                url.search = params.toString();
                const link = document.createElement("a");
                link.href = url.toString();
                link.click();
            };

            root.querySelector("[data-so-company]")?.addEventListener("change", () => {
                refreshDetails();
            });
            root.querySelector("[data-so-refresh]")?.addEventListener("click", () => {
                refreshDetails();
            });
            root.querySelector("[data-so-export-all]")?.addEventListener("click", () => {
                const companyId = root.querySelector("[data-so-company]")?.value ?? "";
                const params = new URLSearchParams();
                if (companyId) {
                    params.set("handler", "ExportCompany");
                    params.set("companyId", companyId);
                } else {
                    params.set("handler", "ExportAll");
                }
                downloadReport(params);
            });
            filters?.addEventListener("submit", (event) => {
                event.preventDefault();
                refreshDetails();
            });

            document.addEventListener("click", (event) => {
                root.querySelectorAll("details.report-load-warning").forEach((menu) => {
                    if (!menu.contains(event.target)) menu.removeAttribute("open");
                });
            });

            root.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;
                root.querySelectorAll("details.report-load-warning")
                    .forEach((menu) => menu.removeAttribute("open"));
            });

            const initialStatus = root.getAttribute("data-so-status") || "loading";
            applyStatus(initialStatus);
            if (initialStatus !== "error")
                refreshDetails();
            window.addEventListener("resize", syncHeaderOffset);
        })();
    </script>
    <script src="~/js/so-listing.js" asp-append-version="true"></script>
</section>
