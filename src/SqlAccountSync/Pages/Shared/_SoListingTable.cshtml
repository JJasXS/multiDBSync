@model IReadOnlyList<SoListingRow>
@{
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value;
    string Money(decimal? amount) =>
        amount?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    string Day(DateTime? value) =>
        value?.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "";
}
<table class="txn-matrix so-matrix" data-so-panel="ready" aria-label="SO Listing and Occupancy">
    <thead>
        <tr>
            <th class="so-col-entity" rowspan="2" scope="col" data-sort="0" data-sort-type="text" tabindex="0" aria-sort="none">COMPANY</th>
            <th class="so-col-properties" rowspan="2" scope="col" data-sort="1" data-sort-type="text" tabindex="0" aria-sort="none">Properties</th>
            <th class="so-col-type" rowspan="2" scope="col" data-sort="2" data-sort-type="text" tabindex="0" aria-sort="none">Type</th>
            <th class="so-col-code" rowspan="2" scope="col" data-sort="3" data-sort-type="text" tabindex="0" aria-sort="none">Project Code</th>
            <th class="so-col-so" rowspan="2" scope="col" data-sort="4" data-sort-type="text" tabindex="0" aria-sort="none">SO No</th>
            <th class="so-group so-group-edge" colspan="5" scope="colgroup">Deposit from Tenant</th>
            <th class="so-col-tenant" rowspan="2" scope="col" data-sort="10" data-sort-type="text" tabindex="0" aria-sort="none">Tenant Name</th>
            <th class="so-col-trade" rowspan="2" scope="col" data-sort="11" data-sort-type="text" tabindex="0" aria-sort="none">Trade Name</th>
            <th class="so-col-reg" rowspan="2" scope="col" data-sort="12" data-sort-type="text" tabindex="0" aria-sort="none">Registration No</th>
            <th class="so-col-tin" rowspan="2" scope="col" data-sort="13" data-sort-type="text" tabindex="0" aria-sort="none">TIN</th>
            <th class="so-col-address" rowspan="2" scope="col" data-sort="14" data-sort-type="text" tabindex="0" aria-sort="none">Address</th>
            <th class="so-col-postal" rowspan="2" scope="col" data-sort="15" data-sort-type="text" tabindex="0" aria-sort="none">Postal Code</th>
            <th class="so-col-city" rowspan="2" scope="col" data-sort="16" data-sort-type="text" tabindex="0" aria-sort="none">City</th>
            <th class="so-col-email" rowspan="2" scope="col" data-sort="17" data-sort-type="text" tabindex="0" aria-sort="none">Email</th>
            <th class="so-col-contact" rowspan="2" scope="col" data-sort="18" data-sort-type="text" tabindex="0" aria-sort="none">Contact No</th>
            <th class="so-group so-group-edge" colspan="4" scope="colgroup">Term</th>
        </tr>
        <tr>
            <th class="so-col-money so-group-edge" scope="col" data-sort="5" data-sort-type="money" tabindex="0" aria-sort="none">Security Deposit</th>
            <th class="so-col-money" scope="col" data-sort="6" data-sort-type="money" tabindex="0" aria-sort="none">Utilities Deposit</th>
            <th class="so-col-money" scope="col" data-sort="7" data-sort-type="money" tabindex="0" aria-sort="none">Fit Out Deposits</th>
            <th class="so-col-money" scope="col" data-sort="8" data-sort-type="money" tabindex="0" aria-sort="none">Access Card</th>
            <th class="so-col-money" scope="col" data-sort="9" data-sort-type="money" tabindex="0" aria-sort="none">Booking Deposits</th>
            <th class="so-col-date so-group-edge" scope="col" data-sort="19" data-sort-type="date" tabindex="0" aria-sort="none">Tenant Start</th>
            <th class="so-col-date" scope="col" data-sort="20" data-sort-type="date" tabindex="0" aria-sort="none">Tenant End</th>
            <th class="so-col-money" scope="col" data-sort="21" data-sort-type="money" tabindex="0" aria-sort="none">Monthly Rental</th>
            <th class="so-col-money" scope="col" data-sort="22" data-sort-type="money" tabindex="0" aria-sort="none">Service Charge</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td class="so-no-records" colspan="23">No records to display.</td>
            </tr>
        }
        else
        {
            foreach (var row in Model)
            {
                var company = Text(row.Company);
                var properties = Text(row.Properties);
                var type = Text(row.Type);
                var projectCode = Text(row.ProjectCode);
                var soNo = Text(row.SoNo);
                var tenantName = Text(row.TenantName);
                var tradeName = Text(row.TradeName);
                var registrationNo = Text(row.RegistrationNo);
                var tin = Text(row.Tin);
                var address = Text(row.Address);
                var postalCode = Text(row.PostalCode);
                var city = Text(row.City);
                var email = Text(row.Email);
                var contactNo = Text(row.ContactNo);
                <tr>
                    <td class="so-col-entity" title="@company">@company</td>
                    <td class="so-col-properties" title="@properties">@properties</td>
                    <td class="so-col-type" title="@type">@type</td>
                    <td class="so-col-code" title="@projectCode">@projectCode</td>
                    <td class="so-col-so" title="@soNo">@soNo</td>
                    <td class="so-col-money so-group-edge">@Money(row.SecurityDeposit)</td>
                    <td class="so-col-money">@Money(row.UtilitiesDeposit)</td>
                    <td class="so-col-money">@Money(row.FitOutDeposits)</td>
                    <td class="so-col-money">@Money(row.AccessCard)</td>
                    <td class="so-col-money">@Money(row.BookingDeposits)</td>
                    <td class="so-col-tenant" title="@tenantName">@tenantName</td>
                    <td class="so-col-trade" title="@tradeName">@tradeName</td>
                    <td class="so-col-reg" title="@registrationNo">@registrationNo</td>
                    <td class="so-col-tin" title="@tin">@tin</td>
                    <td class="so-col-address" title="@address">@address</td>
                    <td class="so-col-postal" title="@postalCode">@postalCode</td>
                    <td class="so-col-city" title="@city">@city</td>
                    <td class="so-col-email" title="@email">@email</td>
                    <td class="so-col-contact" title="@contactNo">@contactNo</td>
                    <td class="so-col-date so-group-edge">@Day(row.TenantStart)</td>
                    <td class="so-col-date">@Day(row.TenantEnd)</td>
                    <td class="so-col-money">@Money(row.MonthlyRental)</td>
                    <td class="so-col-money">@Money(row.ServiceCharge)</td>
                </tr>
            }
        }
    </tbody>
</table>
