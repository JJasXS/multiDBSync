@model IReadOnlyList<DashboardDetailRow>
@{
    var months = new[]
    {
        new { Key = "jan", Label = "Jan" },
        new { Key = "feb", Label = "Feb" },
        new { Key = "mar", Label = "Mar" },
        new { Key = "apr", Label = "Apr" },
        new { Key = "may", Label = "May" },
        new { Key = "jun", Label = "Jun" },
        new { Key = "jul", Label = "Jul" },
        new { Key = "aug", Label = "Aug" },
        new { Key = "sep", Label = "Sep" },
        new { Key = "oct", Label = "Oct" },
        new { Key = "nov", Label = "Nov" },
        new { Key = "dec", Label = "Dec" },
    };
    var hasRows = Model.Any(row => row.LoadFailed || row.CollectionLines.Count > 0);

    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value;
    string ReceiptAmount(decimal amount) => amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="txn-lines-scroll" data-txn-panel="ready">
    <table class="txn-lines mom-lines" aria-label="Collection Report">
        <thead>
            <tr>
                <th class="mom-sticky mom-col-database" data-txn-col="database" scope="col">
                    <span class="mom-col-title">PROJECT</span>
                </th>
                <th class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities" scope="col">
                    <span class="mom-col-title">ENTITIES</span>
                </th>
                <th class="mom-col-properties" data-txn-col="properties" scope="col">
                    <span class="mom-col-title">PROPERTIES</span>
                </th>
                <th class="mom-col-type" data-txn-col="type" scope="col">
                    <span class="mom-col-title">TYPE</span>
                </th>
                <th class="mom-col-project" data-txn-col="project" scope="col">
                    <span class="mom-col-title">PROJECT CODE</span>
                </th>
                @foreach (var month in months)
                {
                    <th class="mom-month mom-group-edge" colspan="2" data-txn-col="@month.Key" scope="colgroup">@month.Label</th>
                }
            </tr>
            <tr>
                <th class="mom-sticky mom-col-database" data-txn-col="database" scope="col">
                    <span class="mom-col-source" title="SYNC_DATABASE.DISPLAYNAME">SYNC_DATABASE.DISPLAYNAME</span>
                </th>
                <th class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities" scope="col">
                    <span class="mom-col-source" title="SL_IV.COMPANYNAME">SL_IV.COMPANYNAME</span>
                </th>
                <th class="mom-col-properties" data-txn-col="properties" scope="col">
                    <span class="mom-col-source" title="SL_IV.UDF_PROJECTDESC">SL_IV.UDF_PROJECTDESC</span>
                </th>
                <th class="mom-col-type" data-txn-col="type" scope="col">
                    <span class="mom-col-source" title="SL_IV.UDF_PROPTYPE">SL_IV.UDF_PROPTYPE</span>
                </th>
                <th class="mom-col-project" data-txn-col="project" scope="col">
                    <span class="mom-col-source" title="SL_IV.DOCNOEX">SL_IV.DOCNOEX</span>
                </th>
                @foreach (var month in months)
                {
                    <th class="mom-sub mom-sub-invoice mom-group-edge" data-txn-col="@month.Key" scope="col">
                        <span class="mom-col-title">Invoice</span>
                        <span class="mom-col-source" title="SL_IV.DOCAMT">SL_IV.DOCAMT</span>
                    </th>
                    <th class="mom-sub mom-sub-receipt" data-txn-col="@month.Key" scope="col">
                        <span class="mom-col-title">Receipt</span>
                        <span class="mom-col-source" title="SL_IV.UDF_ORAMT">SL_IV.UDF_ORAMT</span>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (!hasRows)
            {
                <tr>
                    <td class="txn-tree-empty" colspan="@(5 + (months.Length * 2))">No data found</td>
                </tr>
            }
            else
            {
                foreach (var row in Model)
                {
                    var project = Text(row.DatabaseName);
                    if (row.LoadFailed)
                    {
                        <tr>
                            <td class="mom-sticky mom-col-database" data-txn-col="database" title="@project">@project</td>
                            <td class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities">Could not load this company.</td>
                            <td class="mom-col-properties" data-txn-col="properties"></td>
                            <td class="mom-col-type" data-txn-col="type"></td>
                            <td class="mom-col-project" data-txn-col="project"></td>
                            @foreach (var month in months)
                            {
                                <td class="mom-money mom-invoice mom-group-edge" data-txn-col="@month.Key"></td>
                                <td class="mom-receipt" data-txn-col="@month.Key"></td>
                            }
                        </tr>
                        continue;
                    }

                    foreach (var line in row.CollectionLines)
                    {
                        var entities = Text(line.Entities);
                        var properties = Text(line.Properties);
                        var type = Text(line.Type);
                        var projectCode = Text(line.ProjectCode);
                        <tr>
                            <td class="mom-sticky mom-col-database" data-txn-col="database" title="@project">@project</td>
                            <td class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities" title="@entities">@entities</td>
                            <td class="mom-col-properties" data-txn-col="properties" title="@properties">@properties</td>
                            <td class="mom-col-type" data-txn-col="type" title="@type">@type</td>
                            <td class="mom-col-project" data-txn-col="project" title="@projectCode">@projectCode</td>
                            @for (var monthIndex = 0; monthIndex < months.Length; monthIndex++)
                            {
                                var entries = line.ReceiptsByMonth[monthIndex]
                                    .SelectMany(item => item.Receipts)
                                    .ToList();
                                <td class="mom-money mom-invoice mom-group-edge" data-txn-col="@months[monthIndex].Key">
                                    @if (entries.Count > 0)
                                    {
                                        <div class="mom-receipt-amt">@ReceiptAmount(entries.Sum(item => item.InvoiceAmount))</div>
                                    }
                                </td>
                                <td class="mom-receipt" data-txn-col="@months[monthIndex].Key">
                                    @if (entries.Count > 0)
                                    {
                                        <div class="mom-receipt-amt">@ReceiptAmount(entries.Sum(item => item.Amount))</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
