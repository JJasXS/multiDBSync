@model IReadOnlyList<DashboardDetailRow>
@{
    var months = new[]
    {
        new { Key = "jan", Label = "Jan" },
        new { Key = "feb", Label = "Feb" },
        new { Key = "mar", Label = "Mar" },
        new { Key = "apr", Label = "Apr" },
        new { Key = "may", Label = "May" },
        new { Key = "jun", Label = "Jun" },
        new { Key = "jul", Label = "Jul" },
        new { Key = "aug", Label = "Aug" },
        new { Key = "sep", Label = "Sep" },
        new { Key = "oct", Label = "Oct" },
        new { Key = "nov", Label = "Nov" },
        new { Key = "dec", Label = "Dec" },
    };
    var hasRows = Model.Any(row => !row.LoadFailed && row.CollectionLines.Count > 0);
    var invoiceTotals = new decimal[months.Length];
    var receiptTotals = new decimal[months.Length];
    var columnCount = 6 + (months.Length * 2) + 2;

    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value;
    string ReceiptAmount(decimal amount) => amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
    string RawAmount(decimal amount) => amount.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<div class="txn-lines-scroll" data-txn-panel="ready">
    <table class="txn-lines mom-lines" aria-label="Collection Report">
        <thead>
            <tr>
                <th class="mom-sticky mom-col-database" data-txn-col="database" scope="col" rowspan="2">
                    <span class="mom-col-title">PROJECT</span>
                </th>
                <th class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities" scope="col" rowspan="2">
                    <span class="mom-col-title">ENTITIES</span>
                </th>
                <th class="mom-col-properties" data-txn-col="properties" scope="col" rowspan="2">
                    <span class="mom-col-title">PROPERTIES</span>
                </th>
                <th class="mom-col-type" data-txn-col="type" scope="col" rowspan="2">
                    <span class="mom-col-title">TYPE</span>
                </th>
                <th class="mom-col-project" data-txn-col="project" scope="col" rowspan="2">
                    <span class="mom-col-title">PROJECT CODE</span>
                </th>
                <th class="mom-col-lot" data-txn-col="lot" scope="col" rowspan="2">
                    <span class="mom-col-title">LOT NUMBER</span>
                </th>
                @foreach (var month in months)
                {
                    <th class="mom-month mom-group-edge" colspan="2" data-txn-col="@month.Key" scope="colgroup">@month.Label</th>
                }
                <th class="mom-total mom-total-group mom-group-edge" colspan="2" scope="colgroup">Total</th>
            </tr>
            <tr>
                @foreach (var month in months)
                {
                    <th class="mom-sub mom-sub-invoice mom-group-edge" data-txn-col="@month.Key" scope="col">
                        <span class="mom-col-title">Invoice</span>
                    </th>
                    <th class="mom-sub mom-sub-receipt" data-txn-col="@month.Key" scope="col">
                        <span class="mom-col-title">Receipt</span>
                    </th>
                }
                <th class="mom-sub mom-sub-invoice mom-total mom-total-invoice mom-group-edge" scope="col">
                    <span class="mom-col-title">Invoice</span>
                </th>
                <th class="mom-sub mom-sub-receipt mom-total mom-total-receipt" scope="col">
                    <span class="mom-col-title">Receipt</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (!hasRows)
            {
                <tr>
                    <td class="txn-tree-empty" colspan="@columnCount">No data found</td>
                </tr>
            }
            else
            {
                foreach (var row in Model)
                {
                    if (row.LoadFailed)
                        continue;

                    var project = Text(row.DatabaseName);
                    var lines = row.CollectionLines;
                    for (var lineIndex = 0; lineIndex < lines.Count; lineIndex++)
                    {
                        var line = lines[lineIndex];
                        var entities = Text(line.Entities);
                        var properties = Text(line.Properties);
                        var type = Text(line.Type);
                        var projectCode = Text(line.ProjectCode);
                        var entitySpan = 0;
                        if (lineIndex == 0 || !string.Equals(entities, Text(lines[lineIndex - 1].Entities), StringComparison.Ordinal))
                        {
                            entitySpan = 1;
                            for (var next = lineIndex + 1; next < lines.Count && string.Equals(Text(lines[next].Entities), entities, StringComparison.Ordinal); next++)
                                entitySpan++;
                        }
                        decimal rowInvoice = 0m;
                        decimal rowReceipt = 0m;
                        <tr>
                            <td class="mom-sticky mom-col-database" data-txn-col="database" title="@project">@project</td>
                            @if (entitySpan > 0)
                            {
                                <td class="mom-sticky mom-col-entities mom-sticky-edge" data-txn-col="entities" title="@entities" rowspan="@entitySpan">@entities</td>
                            }
                            <td class="mom-col-properties" data-txn-col="properties" title="@properties">@properties</td>
                            <td class="mom-col-type" data-txn-col="type" title="@type">@type</td>
                            <td class="mom-col-project" data-txn-col="project" title="@projectCode">@projectCode</td>
                            <td class="mom-col-lot" data-txn-col="lot" title="@Text(line.LotNumber)">@Text(line.LotNumber)</td>
                            @for (var monthIndex = 0; monthIndex < months.Length; monthIndex++)
                            {
                                var entries = line.ReceiptsByMonth[monthIndex]
                                    .SelectMany(item => item.Receipts)
                                    .ToList();
                                var invoice = entries.Count > 0 ? entries.Sum(item => item.InvoiceAmount) : 0m;
                                var receipt = entries.Count > 0 ? entries.Sum(item => item.Amount) : 0m;
                                invoiceTotals[monthIndex] += invoice;
                                receiptTotals[monthIndex] += receipt;
                                rowInvoice += invoice;
                                rowReceipt += receipt;
                                <td class="mom-money mom-invoice mom-group-edge" data-txn-col="@months[monthIndex].Key" data-mom-kind="invoice" data-mom-amount="@RawAmount(invoice)">
                                    @if (entries.Count > 0)
                                    {
                                        <div class="mom-receipt-amt">@ReceiptAmount(invoice)</div>
                                    }
                                </td>
                                <td class="mom-receipt" data-txn-col="@months[monthIndex].Key" data-mom-kind="receipt" data-mom-amount="@RawAmount(receipt)">
                                    @if (entries.Count > 0)
                                    {
                                        <div class="mom-receipt-amt">@ReceiptAmount(receipt)</div>
                                    }
                                </td>
                            }
                            <td class="mom-money mom-invoice mom-total mom-total-invoice mom-group-edge" data-mom-row-total="invoice">@ReceiptAmount(rowInvoice)</td>
                            <td class="mom-receipt mom-total mom-total-receipt" data-mom-row-total="receipt">@ReceiptAmount(rowReceipt)</td>
                        </tr>
                    }
                }
            }
        </tbody>
        @if (hasRows)
        {
            decimal grandInvoice = 0m;
            decimal grandReceipt = 0m;
            for (var monthIndex = 0; monthIndex < months.Length; monthIndex++)
            {
                grandInvoice += invoiceTotals[monthIndex];
                grandReceipt += receiptTotals[monthIndex];
            }
            <tfoot>
                <tr class="mom-row-total">
                    <th class="mom-sticky mom-total-label mom-sticky-edge"
                        colspan="6"
                        data-mom-label-span
                        scope="row">TOTAL</th>
                    @for (var monthIndex = 0; monthIndex < months.Length; monthIndex++)
                    {
                        <td class="mom-money mom-invoice mom-group-edge" data-txn-col="@months[monthIndex].Key" data-mom-foot="invoice">@ReceiptAmount(invoiceTotals[monthIndex])</td>
                        <td class="mom-receipt" data-txn-col="@months[monthIndex].Key" data-mom-foot="receipt">@ReceiptAmount(receiptTotals[monthIndex])</td>
                    }
                    <td class="mom-money mom-invoice mom-total mom-total-invoice mom-group-edge" data-mom-foot="invoice-grand">@ReceiptAmount(grandInvoice)</td>
                    <td class="mom-receipt mom-total mom-total-receipt" data-mom-foot="receipt-grand">@ReceiptAmount(grandReceipt)</td>
                </tr>
            </tfoot>
        }
    </table>
</div>
