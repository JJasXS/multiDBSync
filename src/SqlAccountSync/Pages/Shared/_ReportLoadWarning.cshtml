@model IReadOnlyList<string>
@{
    var companies = (Model ?? Array.Empty<string>())
        .Select(name => (name ?? "").Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}
@if (companies.Count > 0)
{
    var companyWord = companies.Count == 1 ? "company" : "companies";
    var label = $"Could not load {companies.Count} {companyWord}";
    <details class="report-load-warning report-load-warning--icon">
        <summary aria-label="@label. Show error details">
            <span class="report-load-warning-icon" aria-hidden="true">!</span>
            <span class="visually-hidden">@label</span>
        </summary>
        <div class="report-load-warning-panel" role="region" aria-label="Load errors">
            <p class="report-load-warning-panel-title">@label</p>
            <p class="report-load-warning-panel-hint">These companies failed to load. Results above may be incomplete.</p>
            <ul>
                @foreach (var company in companies)
                {
                    <li>@company</li>
                }
            </ul>
        </div>
    </details>
}
