@model IReadOnlyList<string>
@{
    var companies = (Model ?? Array.Empty<string>())
        .Select(name => (name ?? "").Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}
@if (companies.Count > 0)
{
    var companyWord = companies.Count == 1 ? "company" : "companies";
    <details class="report-load-warning">
        <summary>
            <span class="report-load-warning-text">&#9888; Partial data shown — @companies.Count @companyWord could not be loaded.</span>
            <span class="report-load-warning-action">
                <span class="report-load-warning-closed">View details</span>
                <span class="report-load-warning-open">Hide details</span>
            </span>
        </summary>
        <ul>
            @foreach (var company in companies)
            {
                <li>@company</li>
            }
        </ul>
    </details>
}
