@model IReadOnlyList<DashboardDetailRow>
@{
    var matrix = PlByProjectMatrix.From(Model);
    var columnTotals = new decimal[matrix.Companies.Count];
    decimal grandTotal = 0m;
    foreach (var row in matrix.Rows)
    {
        for (var companyIndex = 0; companyIndex < columnTotals.Length; companyIndex++)
            columnTotals[companyIndex] += row.Amounts[companyIndex];
        grandTotal += row.Total;
    }
    string Money(decimal amount) => amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "---" : value;
}
<table class="txn-matrix" data-txn-panel="ready" aria-label="Profit and Loss by Project">
    <thead>
        <tr>
            <th class="pl-col-code" scope="col">CODE</th>
            <th class="pl-col-desc" scope="col">ACCOUNT DESCRIPTION</th>
            @foreach (var company in matrix.Companies)
            {
                <th class="pl-col-company" scope="col" title="@company">@company</th>
            }
            <th class="pl-col-total" scope="col">TOTAL AMOUNT</th>
        </tr>
    </thead>
    <tbody>
        @if (matrix.Rows.Count == 0)
        {
            <tr>
                <td class="txn-no-records" colspan="@(matrix.Companies.Count + 3)">No transaction data to display.</td>
            </tr>
        }
        else
        {
            foreach (var row in matrix.Rows)
            {
                <tr>
                    <td class="pl-col-code" title="@row.Code">@Text(row.Code)</td>
                    <td class="pl-col-desc" title="@row.Description">@Text(row.Description)</td>
                    @foreach (var amount in row.Amounts)
                    {
                        <td class="pl-col-company">@Money(amount)</td>
                    }
                    <td class="pl-col-total">@Money(row.Total)</td>
                </tr>
            }
        }
    </tbody>
    @if (matrix.Rows.Count > 0)
    {
        <tfoot>
            <tr class="pl-row-total">
                <th class="pl-col-code" scope="row">TOTAL</th>
                <td class="pl-col-desc"></td>
                @foreach (var amount in columnTotals)
                {
                    <td class="pl-col-company">@Money(amount)</td>
                }
                <td class="pl-col-total">@Money(grandTotal)</td>
            </tr>
        </tfoot>
    }
</table>
