@model IReadOnlyList<DashboardDetailRow>
@{
    var failedCompanies = Model
        .Where(row => row.LoadFailed)
        .Select(row => (row.DatabaseName ?? "").Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var reportRows = Model.Where(row => !row.LoadFailed).ToList();
    var emptyCompanies = reportRows
        .Where(row => row.CollectionLines.Count == 0)
        .Select(row => (row.DatabaseName ?? "").Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}
@if (failedCompanies.Count > 0)
{
    var failureMessages = new List<string>();
    foreach (var row in Model.Where(row => row.LoadFailed))
    {
        if (row.LoadErrors.Count > 0)
            failureMessages.AddRange(row.LoadErrors);
        else if (!string.IsNullOrWhiteSpace(row.DatabaseName))
            failureMessages.Add(row.DatabaseName.Trim());
    }
    var failedWord = failedCompanies.Count == 1 ? "company" : "companies";
    var failedLabel = $"Partial data shown — {failedCompanies.Count} {failedWord} could not be loaded.";
    <div class="report-load-warning-slot" role="status" data-txn-panel="ready">
        <details class="report-load-warning report-load-warning--icon">
            <summary aria-label="@failedLabel Show error details">
                <span class="report-load-warning-icon" aria-hidden="true">!</span>
                <span class="visually-hidden">@failedLabel</span>
            </summary>
            <div class="report-load-warning-panel" role="region" aria-label="Load errors">
                <p class="report-load-warning-panel-title">@failedLabel</p>
                <ul>
                    @foreach (var message in failureMessages)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        </details>
    </div>
}
@if (emptyCompanies.Count > 0)
{
    var emptyWord = emptyCompanies.Count == 1 ? "company has" : "companies have";
    var emptyLabel = $"No data — {emptyCompanies.Count} {emptyWord} no rows for this year.";
    <div class="report-load-warning-slot" role="status" data-txn-panel="ready">
        <details class="report-load-warning report-load-warning--icon">
            <summary aria-label="@emptyLabel Show details">
                <span class="report-load-warning-icon" aria-hidden="true">!</span>
                <span class="visually-hidden">@emptyLabel</span>
            </summary>
            <div class="report-load-warning-panel" role="region" aria-label="Empty companies">
                <p class="report-load-warning-panel-title">@emptyLabel</p>
                <ul>
                    @foreach (var company in emptyCompanies)
                    {
                        <li>@company</li>
                    }
                </ul>
            </div>
        </details>
    </div>
}
@if (reportRows.Count == 0)
{
    <p class="empty txn-summary-status" data-txn-panel="ready">No transaction data to display.</p>
}
else
{
    <partial name="_TransactionTable" model="reportRows" />
}
