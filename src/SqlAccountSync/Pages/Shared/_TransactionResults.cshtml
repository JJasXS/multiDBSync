@model IReadOnlyList<DashboardDetailRow>
@{
    var failedCompanies = Model
        .Where(row => row.LoadFailed)
        .Select(row => (row.DatabaseName ?? "").Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var reportRows = Model.Where(row => !row.LoadFailed).ToList();
}
@if (failedCompanies.Count > 0)
{
    <div class="report-load-warning-slot" role="status" data-txn-panel="ready">
        <partial name="_ReportLoadWarning" model="failedCompanies" />
    </div>
}
@if (reportRows.Count == 0)
{
    <p class="empty txn-summary-status" data-txn-panel="ready">No transaction data to display.</p>
}
else
{
    <partial name="_TransactionTable" model="reportRows" />
}
