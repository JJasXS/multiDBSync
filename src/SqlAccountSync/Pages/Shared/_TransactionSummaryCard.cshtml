@model DashboardDetailsModel
<section class="card txn-summary mom-collection" data-txn-summary>
    <div class="card-head">
        <h3>Details</h3>
    </div>
    <partial name="_TransactionFilters" />
    <div class="table-wrap txn-summary-scroll">
        <div data-txn-results>
            <partial name="_TransactionResults" model="Model.Rows" />
        </div>
        <p class="empty txn-summary-status" data-txn-panel="loading" hidden>Loading transaction data.</p>
        <p class="empty txn-summary-status" data-txn-panel="error" hidden>Transaction data could not be loaded.</p>
    </div>
    <script>
        (() => {
            const root = document.querySelector("[data-txn-summary]");
            if (!root) return;

            // Local preview only. Set showEmpty to true to preview the empty message.
            // status accepts "ready", "empty", "loading", or "error".
            const txnPreview = {
                showEmpty: false,
                status: "ready"
            };

            const filters = root.querySelector("[data-txn-filters]");
            const panels = () => root.querySelectorAll("[data-txn-panel]");
            const toggles = () => [...root.querySelectorAll("[data-txn-col-toggle]")];

            const resolveStatus = () => txnPreview.showEmpty ? "empty" : txnPreview.status;

            const applyStatus = () => {
                const status = resolveStatus();
                panels().forEach((panel) => {
                    panel.hidden = panel.getAttribute("data-txn-panel") !== status;
                });
            };

            const stickyKeys = ["database", "entities"];

            const parseAmount = (raw) => {
                const text = String(raw ?? "0").trim();
                const negative = text.startsWith("-");
                const unsigned = negative ? text.slice(1) : text;
                const bits = unsigned.split(".");
                const whole = (bits[0] || "0").replace(/[^\d]/g, "") || "0";
                const frac = (bits[1] || "").replace(/[^\d]/g, "");
                return { negative, whole, frac };
            };

            const sumAmounts = (cells) => {
                const parts = [];
                cells.forEach((cell) => {
                    if (cell.hidden) return;
                    parts.push(parseAmount(cell.getAttribute("data-mom-amount")));
                });
                const scale = parts.reduce((max, part) => Math.max(max, part.frac.length), 0);
                let total = 0n;
                parts.forEach((part) => {
                    const digits = `${part.whole}${part.frac.padEnd(scale, "0")}` || "0";
                    const value = BigInt(digits);
                    total += part.negative ? -value : value;
                });
                return { total, scale };
            };

            const formatMoney = (scaled) => {
                const negative = scaled.total < 0n;
                let abs = negative ? -scaled.total : scaled.total;
                const scale = scaled.scale;
                if (scale > 2) {
                    const factor = 10n ** BigInt(scale - 2);
                    const base = abs / factor;
                    const remainder = abs % factor;
                    abs = remainder * 2n >= factor ? base + 1n : base;
                } else if (scale < 2) {
                    abs *= 10n ** BigInt(2 - scale);
                }
                const digits = abs.toString().padStart(3, "0");
                const whole = digits.slice(0, -2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                const frac = digits.slice(-2);
                return `${negative && abs !== 0n ? "-" : ""}${whole}.${frac}`;
            };

            const applyMomTotals = () => {
                root.querySelectorAll(".mom-lines").forEach((table) => {
                    const rows = [...table.querySelectorAll("tbody tr")].filter((row) => row.querySelector("[data-mom-row-total]"));
                    rows.forEach((row) => {
                        const invoiceCell = row.querySelector("[data-mom-row-total='invoice']");
                        const receiptCell = row.querySelector("[data-mom-row-total='receipt']");
                        if (invoiceCell) invoiceCell.textContent = formatMoney(sumAmounts(row.querySelectorAll("td[data-mom-kind='invoice']")));
                        if (receiptCell) receiptCell.textContent = formatMoney(sumAmounts(row.querySelectorAll("td[data-mom-kind='receipt']")));
                    });
                    const monthKeys = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
                    monthKeys.forEach((key) => {
                        const invoiceCells = [];
                        const receiptCells = [];
                        rows.forEach((row) => {
                            const invoice = row.querySelector(`td[data-mom-kind='invoice'][data-txn-col='${key}']`);
                            const receipt = row.querySelector(`td[data-mom-kind='receipt'][data-txn-col='${key}']`);
                            if (invoice) invoiceCells.push(invoice);
                            if (receipt) receiptCells.push(receipt);
                        });
                        const invoiceFoot = table.querySelector(`tfoot [data-mom-foot='invoice'][data-txn-col='${key}']`);
                        const receiptFoot = table.querySelector(`tfoot [data-mom-foot='receipt'][data-txn-col='${key}']`);
                        if (invoiceFoot) invoiceFoot.textContent = formatMoney(sumAmounts(invoiceCells));
                        if (receiptFoot) receiptFoot.textContent = formatMoney(sumAmounts(receiptCells));
                    });
                    const visibleInvoice = [];
                    const visibleReceipt = [];
                    rows.forEach((row) => {
                        row.querySelectorAll("td[data-mom-kind='invoice']").forEach((cell) => visibleInvoice.push(cell));
                        row.querySelectorAll("td[data-mom-kind='receipt']").forEach((cell) => visibleReceipt.push(cell));
                    });
                    const grandInvoice = table.querySelector("[data-mom-foot='invoice-grand']");
                    const grandReceipt = table.querySelector("[data-mom-foot='receipt-grand']");
                    if (grandInvoice) grandInvoice.textContent = formatMoney(sumAmounts(visibleInvoice));
                    if (grandReceipt) grandReceipt.textContent = formatMoney(sumAmounts(visibleReceipt));
                    const labels = [...table.querySelectorAll("tfoot [data-mom-label]")];
                    labels.forEach((cell) => { cell.textContent = ""; });
                    const firstLabel = labels.find((cell) => !cell.hidden);
                    if (firstLabel) firstLabel.textContent = "TOTAL";
                });
            };

            const applyStickyColumns = (selected) => {
                stickyKeys.forEach((key) => {
                    if (selected.has(key)) root.style.removeProperty(`--mom-${key}`);
                    else root.style.setProperty(`--mom-${key}`, "0px");
                });
                root.querySelectorAll(".mom-sticky-edge").forEach((cell) => cell.classList.remove("mom-sticky-edge"));
                const edge = [...stickyKeys].reverse().find((key) => selected.has(key));
                if (edge) {
                    root.querySelectorAll(`[data-txn-col="${edge}"].mom-sticky`).forEach((cell) => {
                        cell.classList.add("mom-sticky-edge");
                    });
                }
                root.querySelectorAll(".mom-lines").forEach((table) => {
                    const month = [...table.querySelectorAll("thead tr:first-child th.mom-month:not(.mom-total)")]
                        .find((cell) => !cell.hidden);
                    if (month) {
                        const height = Math.round(month.getBoundingClientRect().height);
                        if (height > 0) table.style.setProperty("--mom-head-1", `${height}px`);
                    }
                    const invoice = table.querySelector("thead tr:nth-child(2) th.mom-total-invoice");
                    const receipt = table.querySelector("thead tr:nth-child(2) th.mom-total-receipt");
                    if (invoice && receipt) {
                        const invoiceWidth = invoice.getBoundingClientRect().width;
                        const receiptWidth = receipt.getBoundingClientRect().width;
                        if (invoiceWidth > 0) table.style.setProperty("--mom-total-invoice", `${invoiceWidth}px`);
                        if (receiptWidth > 0) table.style.setProperty("--mom-total-receipt", `${receiptWidth}px`);
                    }
                });
            };

            const applyColumns = () => {
                const boxes = toggles();
                const selected = new Set(boxes.filter((box) => box.checked).map((box) => box.value));
                root.querySelectorAll("[data-txn-col]").forEach((cell) => {
                    cell.hidden = !selected.has(cell.getAttribute("data-txn-col"));
                });
                applyMomTotals();
                applyStickyColumns(selected);
                const count = selected.size;
                root.querySelectorAll("[data-txn-record], [data-txn-empty]").forEach((cell) => {
                    cell.hidden = count === 0;
                    if (count > 0) cell.colSpan = count;
                });
                const subhead = root.querySelector("[data-txn-subhead]");
                if (subhead) subhead.hidden = count === 0;
                const summary = root.querySelector("[data-txn-col-summary]");
                if (!summary) return;
                if (count === boxes.length) summary.textContent = "All columns";
                else if (count === 0) summary.textContent = "None";
                else summary.textContent = boxes
                    .filter((box) => box.checked)
                    .map((box) => box.parentElement?.querySelector("span")?.textContent ?? box.value)
                    .join(", ");
            };

            const dbBoxes = () => [...root.querySelectorAll("[data-txn-db]")];
            const allDatabases = root.querySelector("[data-txn-db-all]");
            let syncingDatabases = false;

            const applyDatabases = () => {
                const boxes = dbBoxes();
                const selected = boxes.filter((box) => box.checked);
                if (allDatabases) {
                    syncingDatabases = true;
                    allDatabases.checked = boxes.length > 0 && selected.length === boxes.length;
                    syncingDatabases = false;
                }
                const summary = root.querySelector("[data-txn-db-summary]");
                const exportReport = root.querySelector("[data-txn-export]");
                if (exportReport) exportReport.disabled = selected.length === 0;
                if (!summary) return;
                if (boxes.length === 0 || selected.length === boxes.length) summary.textContent = "All Company";
                else if (selected.length === 0) summary.textContent = "None";
                else summary.textContent = selected
                    .map((box) => box.getAttribute("data-txn-db-label") || box.value)
                    .join(", ");
            };

            const downloadReport = (params) => {
                if (!filters) return;
                const url = new URL(filters.getAttribute("action"), window.location.href);
                url.search = params.toString();
                const link = document.createElement("a");
                link.href = url.toString();
                link.click();
            };

            const results = root.querySelector("[data-txn-results]");
            const refreshDelayMs = 300;
            let refreshTimer = 0;
            let refreshInFlight = false;
            let refreshAgain = false;

            const showLoading = () => {
                txnPreview.status = "loading";
                applyStatus();
                root.setAttribute("aria-busy", "true");
            };

            const refreshDetails = async () => {
                if (!filters || !results) return;
                if (refreshInFlight) {
                    refreshAgain = true;
                    return;
                }
                refreshInFlight = true;
                showLoading();
                const query = new URLSearchParams(new FormData(filters));
                query.set("handler", "Details");
                try {
                    const response = await fetch(`${filters.getAttribute("action")}?${query}`, {
                        headers: { "X-Requested-With": "fetch" }
                    });
                    if (!response.ok) throw new Error(String(response.status));
                    results.innerHTML = await response.text();
                    txnPreview.status = "ready";
                    applyStatus();
                    applyColumns();
                    root.removeAttribute("aria-busy");
                    const pageQuery = new URLSearchParams(new FormData(filters));
                    const pageUrl = new URL(filters.getAttribute("action"), window.location.href);
                    pageUrl.search = pageQuery.toString();
                    history.replaceState(null, "", pageUrl);
                } catch {
                    txnPreview.status = "error";
                    applyStatus();
                    root.removeAttribute("aria-busy");
                } finally {
                    refreshInFlight = false;
                    if (refreshAgain) {
                        refreshAgain = false;
                        refreshDetails();
                    }
                }
            };

            const scheduleRefresh = () => {
                window.clearTimeout(refreshTimer);
                refreshTimer = window.setTimeout(() => { refreshDetails(); }, refreshDelayMs);
            };

            allDatabases?.addEventListener("change", () => {
                if (syncingDatabases) return;
                dbBoxes().forEach((box) => { box.checked = allDatabases.checked; });
                applyDatabases();
                scheduleRefresh();
            });
            dbBoxes().forEach((box) => box.addEventListener("change", () => {
                applyDatabases();
                scheduleRefresh();
            }));

            toggles().forEach((box) => box.addEventListener("change", applyColumns));

            root.querySelector("[data-txn-year]")?.addEventListener("change", scheduleRefresh);

            root.querySelector("[data-txn-export]")?.addEventListener("click", (event) => {
                if (event.currentTarget.disabled) return;
                const params = new URLSearchParams();
                params.set("handler", "Export");
                params.set("year", root.querySelector("[data-txn-year]")?.value ?? "");
                params.set("dbFilter", "true");
                dbBoxes().filter((box) => box.checked).forEach((box) => params.append("db", box.value));
                downloadReport(params);
            });

            filters?.addEventListener("submit", (event) => {
                event.preventDefault();
                window.clearTimeout(refreshTimer);
                refreshDetails();
            });

            document.addEventListener("click", (event) => {
                root.querySelectorAll("details.txn-col-menu").forEach((menu) => {
                    if (!menu.contains(event.target)) menu.removeAttribute("open");
                });
            });

            root.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;
                root.querySelectorAll("details.txn-col-menu").forEach((menu) => menu.removeAttribute("open"));
            });

            applyColumns();
            applyDatabases();
            applyStatus();
            window.addEventListener("resize", () => applyColumns());
        })();
    </script>
</section>
