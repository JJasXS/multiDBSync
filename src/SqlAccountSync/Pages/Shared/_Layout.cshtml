<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — SQL Account Sync</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@using Microsoft.Extensions.Options
@using SqlAccountSync.Options
@inject IOptions<FeatureOptions> FeatureOptions
@inject SqlAccountSync.Services.Tenants.TenantMenuFlags MenuFlags
@{
    bool IsActive(string page, string? entity = null)
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        if (!string.Equals(current, page, StringComparison.OrdinalIgnoreCase))
            return false;
        if (entity is null)
            return true;
        return string.Equals(Context.Request.Query["entity"].ToString(), entity, StringComparison.OrdinalIgnoreCase);
    }
    string NavClass(string page, string? entity = null) => IsActive(page, entity) ? "active" : "";
    string DatabasesNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current.StartsWith("/Databases/", StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
    string LogsNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Logs" ? "active" : "";
    }
    string DocumentsNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Transactions/Index" or "/Transactions/Details" ? "active" : "";
    }
    string SyncNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Push/Index" or "/Jobs/Index" ? "active" : "";
    }
    bool IsReportPage()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current.StartsWith("/Reports/", StringComparison.OrdinalIgnoreCase);
    }
    var showMappingsUi = FeatureOptions.Value.ShowMappingsUi;
    var showSyncConfigUi = FeatureOptions.Value.ShowSyncConfigUi;
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <div class="nav-backdrop" data-nav-close hidden></div>
        <nav class="nav" id="app-nav" aria-label="Main">
            <div class="nav-brand">
                <div>
                    <span class="mark">Operations</span>
                    <h1>SQL Account Sync</h1>
                </div>
                <button type="button" class="nav-close" data-nav-close aria-label="Close menu">&times;</button>
            </div>
            @if (SqlAccountSync.Services.Auth.CurrentUser.IsAdmin(User))
            {
                <a class="@NavClass("/Users/Index")" asp-page="/Users/Index">User management</a>
            }
            <div class="group">Overview</div>
            <a class="@NavClass("/Index")" asp-page="/Index">Dashboard</a>
            <a class="@DatabasesNavClass()" asp-page="/Databases/Index">Databases</a>
            <div class="nav-tree@(IsReportPage() ? " is-open" : "")">
                <button type="button" class="nav-tree-toggle" data-nav-tree aria-expanded="@(IsReportPage() ? "true" : "false")">
                    <span>Master Report</span>
                    <svg class="nav-chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="nav-tree-children">
                    <a class="@NavClass("/Reports/PlByProject")" asp-page="/Reports/PlByProject">Profit &amp; Loss by Project</a>
                    <a class="@NavClass("/Reports/MomCollection")" asp-page="/Reports/MomCollection">Monthly Collection Report</a>
                    <a class="@NavClass("/Reports/SoListing")" asp-page="/Reports/SoListing">Sales Order Listing &amp; Occupancy</a>
                </div>
            </div>
            @if (showSyncConfigUi || showMappingsUi)
            {
                <div class="group">Configuration</div>
                @if (showSyncConfigUi)
                {
                    <a class="@NavClass("/SyncConfig")" asp-page="/SyncConfig">Sync configuration</a>
                }
                @if (showMappingsUi)
                {
                    <a class="@NavClass("/Mappings/Index")" asp-page="/Mappings/Index" asp-route-entity="ITEM">Mappings</a>
                }
            }
            <div class="group">Operations</div>
            @if (MenuFlags.ShowSynchronization)
            {
                <a class="@SyncNavClass()" asp-page="/Push/Index">Synchronization</a>
            }
            @if (MenuFlags.ShowDocumentTransfer)
            {
                <a class="@DocumentsNavClass()" asp-page="/Transactions/Index">Document transfer</a>
            }
            <a class="@LogsNavClass()" asp-page="/Logs">Logs</a>
            <div class="nav-footer">
                @if (SqlAccountSync.Services.Auth.CurrentUser.IsAdmin(User))
                {
                    <a class="nav-backup" asp-page="/Backup/Index">Backup SYNC.FDB</a>
                }
                <a class="nav-logout" asp-page="/Logout">Log out</a>
            </div>
        </nav>
        <div class="main">
            <div class="topbar">
                <div class="topbar-start">
                    <button type="button" class="hamburger" data-nav-toggle aria-controls="app-nav" aria-expanded="false" aria-label="Open menu">
                        <span></span><span></span><span></span>
                    </button>
                    @if (ViewData["BackHref"] is string backHref && !string.IsNullOrWhiteSpace(backHref))
                    {
                        var backLabel = ViewData["BackLabel"] as string ?? "Back";
                        <a class="topbar-back" href="@backHref" title="@backLabel" aria-label="@backLabel">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/></svg>
                        </a>
                    }
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="topbar-actions">@RenderSection("TopbarActions", required: false)</div>
                <div class="topbar-end">
                    <div class="meta">@User.Identity?.Name</div>
                </div>
            </div>
            @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
            {
                <div class="flash flash-err">@flash</div>
            }
            @RenderBody()
        </div>
    </div>
    <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
    <dialog id="appConfirm" class="accounts-modal app-confirm" aria-labelledby="appConfirmTitle">
        <form method="dialog" class="accounts-modal-form">
            <div class="accounts-modal-head">
                <h3 id="appConfirmTitle" data-confirm-title>Please confirm</h3>
                <button type="button" class="accounts-modal-close" data-confirm-close aria-label="Close">&times;</button>
            </div>
            <div class="accounts-modal-body">
                <p class="app-confirm-message" data-confirm-message></p>
                <div class="app-confirm-phrase" data-confirm-phrase-wrap hidden>
                    <label for="appConfirmPhrase" data-confirm-phrase-label-host>Type <strong data-confirm-phrase-label></strong> to complete</label>
                    <input id="appConfirmPhrase" type="text" autocomplete="off" spellcheck="false" data-confirm-phrase-input />
                </div>
            </div>
            <div class="accounts-modal-actions">
                <button type="button" class="btn btn-ghost" data-confirm-cancel>Cancel</button>
                <button type="button" class="btn danger" data-confirm-alt hidden>Disable all</button>
                <button type="button" class="btn" data-confirm-ok>Confirm</button>
            </div>
        </form>
    </dialog>
}
else
{
    <div class="login-shell">@RenderBody()</div>
}
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
