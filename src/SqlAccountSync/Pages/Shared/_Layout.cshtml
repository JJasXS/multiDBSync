<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — SQL Account Sync</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@using Microsoft.Extensions.Options
@using SqlAccountSync.Options
@inject IOptions<FeatureOptions> FeatureOptions
@{
    bool IsActive(string page, string? entity = null)
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        if (!string.Equals(current, page, StringComparison.OrdinalIgnoreCase))
            return false;
        if (entity is null)
            return true;
        return string.Equals(Context.Request.Query["entity"].ToString(), entity, StringComparison.OrdinalIgnoreCase);
    }
    string NavClass(string page, string? entity = null) => IsActive(page, entity) ? "active" : "";
    string SettingsNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current.StartsWith("/Settings/", StringComparison.OrdinalIgnoreCase)
            || string.Equals(current, "/Settings/Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(current, "/Users/Index", StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }
    string LogsNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Logs" ? "active" : "";
    }
    string DocumentsNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Transactions/Index" or "/Transactions/Details" ? "active" : "";
    }
    string SyncNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Push/Index" or "/Jobs/Index" ? "active" : "";
    }
    string MasterDataNavClass()
    {
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        return current is "/Accounts/Index" or "/Partners/Create" ? "active" : "";
    }
    var showMappingsUi = FeatureOptions.Value.ShowMappingsUi;
    var showSyncConfigUi = FeatureOptions.Value.ShowSyncConfigUi;
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <div class="nav-backdrop" data-nav-close hidden></div>
        <nav class="nav" id="app-nav" aria-label="Main">
            <div class="nav-brand">
                <div>
                    <span class="mark">Operations</span>
                    <h1>SQL Account Sync</h1>
                </div>
                <button type="button" class="nav-close" data-nav-close aria-label="Close menu">&times;</button>
            </div>
            <div class="group">Overview</div>
            <a class="@NavClass("/Index")" asp-page="/Index">Dashboard</a>
            <a class="@NavClass("/Databases/Index")" asp-page="/Databases/Index">Databases</a>
            @if (showSyncConfigUi || showMappingsUi)
            {
                <div class="group">Configuration</div>
                @if (showSyncConfigUi)
                {
                    <a class="@NavClass("/SyncConfig")" asp-page="/SyncConfig">Sync configuration</a>
                }
                @if (showMappingsUi)
                {
                    <a class="@NavClass("/Mappings/Index")" asp-page="/Mappings/Index" asp-route-entity="ITEM">Mappings</a>
                }
            }
            <div class="group">Operations</div>
            <a class="@SyncNavClass()" asp-page="/Push/Index">Synchronization</a>
            <a class="@MasterDataNavClass()" asp-page="/Accounts/Index">Master data</a>
            <a class="@DocumentsNavClass()" asp-page="/Transactions/Index">Document transfer</a>
            <a class="@LogsNavClass()" asp-page="/Logs">Logs</a>
            <div class="nav-footer">
                <a class="nav-logout" asp-page="/Logout">Log out</a>
            </div>
        </nav>
        <div class="main">
            <div class="topbar">
                <div class="topbar-start">
                    <button type="button" class="hamburger" data-nav-toggle aria-controls="app-nav" aria-expanded="false" aria-label="Open menu">
                        <span></span><span></span><span></span>
                    </button>
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="topbar-actions">@RenderSection("TopbarActions", required: false)</div>
                <div class="topbar-end">
                    <div class="meta">@User.Identity?.Name</div>
                    <a class="topbar-settings @SettingsNavClass()" asp-page="/Settings/Index" title="Settings" aria-label="Settings">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
                        </svg>
                    </a>
                </div>
            </div>
            @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
            {
                <div class="flash flash-err">@flash</div>
            }
            @RenderBody()
        </div>
    </div>
    <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
}
else
{
    <div class="login-shell">@RenderBody()</div>
}
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
