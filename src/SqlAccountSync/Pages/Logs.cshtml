@page "/logs"
@model SqlAccountSync.Pages.LogsModel
@{
    ViewData["Title"] = "Logs";
    var showActions = Model.CanOperate || Model.CanManage || Model.Rows.Any(r => !string.IsNullOrWhiteSpace(r.LinkUrl));
    var columns = showActions ? 5 : 4;
}
<div class="card logs-page">
    <div class="logs-filters" role="tablist" aria-label="Log type">
        <button type="button" class="logs-filter is-active" data-log-filter="all">All <span class="count-pill">@Model.Rows.Count</span></button>
        <button type="button" class="logs-filter" data-log-filter="transaction">Transactions <span class="count-pill">@Model.Transactions.Count</span></button>
        <button type="button" class="logs-filter" data-log-filter="audit">Audit <span class="count-pill">@Model.Audits.Count</span></button>
        <button type="button" class="logs-filter" data-log-filter="error">Errors <span class="count-pill">@Model.Errors.Count</span></button>
    </div>
    <section class="push-panel logs-panel">
        <div class="push-panel-head">
            <div>
                <h3>Logs</h3>
                <p class="push-panel-count" data-log-count>@Model.Rows.Count records</p>
            </div>
            <div class="push-panel-search">
                <label class="sr-only" for="logSearch">Search logs</label>
                <input id="logSearch" type="search" placeholder="Search logs..." autocomplete="off" spellcheck="false" />
            </div>
        </div>
        <div class="push-panel-table-wrap">
            <table class="push-panel-table" id="logsTable">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Kind</th>
                        <th>Detail</th>
                        <th>Status</th>
                        @if (showActions)
                        {
                            <th class="col-actions"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@columns" class="empty">No logs yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr data-log-row data-log-kind="@row.Kind" data-log-text="@($"{row.KindLabel} {row.Detail} {row.Status}")">
                            <td>@row.At.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.KindLabel</td>
                            <td><span class="cell-truncate" title="@row.Detail">@row.Detail</span></td>
                            <td><span class="badge @row.BadgeClass" title="@row.StatusTitle">@row.Status</span></td>
                            @if (showActions)
                            {
                                <td class="col-actions">
                                    @if (!string.IsNullOrWhiteSpace(row.LinkUrl))
                                    {
                                        <a class="btn small secondary" href="@row.LinkUrl">@(string.IsNullOrWhiteSpace(row.LinkLabel) ? "Open" : row.LinkLabel)</a>
                                    }
                                    @if (row.RetryTxnPk is int txnPk)
                                    {
                                        <form method="post" asp-page-handler="Retry" asp-route-txnPk="@txnPk"><button class="btn small" type="submit">Retry</button></form>
                                    }
                                    @if (row.ResolveErrorId is int errorId)
                                    {
                                        <form method="post" asp-page-handler="ResolveError" asp-route-id="@errorId"><button class="btn small secondary" type="submit">Resolve</button></form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    <tr id="logSearchEmpty" hidden>
                        <td colspan="@columns" class="empty">No logs match that filter.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
<script>
(() => {
  const search = document.getElementById('logSearch');
  const emptyRow = document.getElementById('logSearchEmpty');
  const count = document.querySelector('[data-log-count]');
  const filters = Array.from(document.querySelectorAll('[data-log-filter]'));
  let kind = 'all';
  const rows = () => Array.from(document.querySelectorAll('#logsTable tbody tr[data-log-row]'));
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    rows().forEach((tr) => {
      const rowKind = tr.getAttribute('data-log-kind') || '';
      const text = (tr.getAttribute('data-log-text') || '').toLowerCase();
      const show = (kind === 'all' || rowKind === kind) && (!q || text.includes(q));
      tr.hidden = !show;
      if (show) visible++;
    });
    if (emptyRow) emptyRow.hidden = visible > 0 || rows().length === 0;
    if (count) count.textContent = `${visible} record${visible === 1 ? '' : 's'}`;
  };
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      kind = btn.getAttribute('data-log-filter') || 'all';
      filters.forEach((item) => item.classList.toggle('is-active', item === btn));
      apply();
    });
  });
  search?.addEventListener('input', apply);
  search?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== 'Escape') return;
    e.preventDefault();
    if (e.key === 'Escape') search.value = '';
    apply();
  });
  const hashKind = { 'error-logs': 'error', 'audit-logs': 'audit', 'history-transaction-logs': 'transaction' };
  const hashed = hashKind[(location.hash || '').replace(/^#/, '')];
  if (hashed) document.querySelector(`[data-log-filter="${hashed}"]`)?.click();
})();
</script>
