@page "/logs"
@model SqlAccountSync.Pages.LogsModel
@{
    ViewData["Title"] = "Logs";
    var showActions = Model.ShowActions;
    var anyRowAction = showActions && Model.Rows.Any(r =>
        !string.IsNullOrWhiteSpace(r.LinkUrl) || r.RetryTxnPk is not null || r.ResolveErrorId is not null);
    var columns = anyRowAction ? 5 : 4;
    var totals = Model.Totals;
}
<div class="card logs-page"
     data-log-total-all="@totals.All"
     data-log-total-transaction="@totals.Transaction"
     data-log-total-audit="@totals.Audit"
     data-log-total-error="@totals.Error"
     data-log-source="@(Model.IsRemoteSource ? "remote-readonly" : "local")">
    @if (Model.IsRemoteSource)
    {
        <p class="logs-remote-banner" role="status">
            Logs from remote TEST SYNC.FDB — @Model.SourceDescription. Retry queues a TXN job here; Resolve updates SYNC_ERROR on this database.
        </p>
    }
    <div class="logs-filters" role="tablist" aria-label="Log type">
        <button type="button" class="logs-filter is-active" data-log-filter="all">All <span class="count-pill">@totals.All</span></button>
        <button type="button" class="logs-filter" data-log-filter="transaction">Transactions <span class="count-pill">@totals.Transaction</span></button>
        <button type="button" class="logs-filter" data-log-filter="audit">Audit <span class="count-pill">@totals.Audit</span></button>
        <button type="button" class="logs-filter" data-log-filter="error">Errors <span class="count-pill">@totals.Error</span></button>
    </div>
    <section class="push-panel logs-panel">
        <div class="push-panel-head">
            <div class="logs-panel-title">
                <h3>Logs</h3>
                <span class="push-panel-count" data-log-count>@totals.All record@(totals.All == 1 ? "" : "s")</span>
            </div>
            <div class="push-panel-search">
                <label class="sr-only" for="logSearch">Search logs</label>
                <input id="logSearch" type="search" placeholder="Search logs..." autocomplete="off" spellcheck="false" />
            </div>
        </div>
        <div class="push-panel-table-wrap" data-log-more="@(Model.HasMore ? "1" : "0")" data-log-actions="@(showActions ? "1" : "0")">
            <table class="push-panel-table@(showActions && !anyRowAction ? " is-actions-hidden" : "")" id="logsTable">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Kind</th>
                        <th>Detail</th>
                        <th>Status</th>
                        @if (showActions)
                        {
                            <th class="col-actions" scope="col">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody id="logRows">
                @if (Model.Rows.Count == 0)
                {
                    <tr data-log-empty>
                        <td colspan="@columns" class="empty" data-log-span>No logs yet.</td>
                    </tr>
                }
                else
                {
                    <partial name="_LogRows" model="new SqlAccountSync.Pages.LogTableBody { Rows = Model.Rows, ShowActions = showActions }" />
                }
                    <tr id="logSearchEmpty" hidden>
                        <td colspan="@columns" class="empty" data-log-span data-log-empty-msg>No logs match that filter.</td>
                    </tr>
                    <tr id="logLoading" hidden>
                        <td colspan="@columns" class="empty" data-log-span>Loading more...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>
<script>
(() => {
  const root = document.querySelector('.logs-page');
  const search = document.getElementById('logSearch');
  const emptyRow = document.getElementById('logSearchEmpty');
  const loadingRow = document.getElementById('logLoading');
  const scroller = document.querySelector('.logs-page .push-panel-table-wrap');
  const count = document.querySelector('[data-log-count]');
  const filters = Array.from(document.querySelectorAll('[data-log-filter]'));
  const pills = Object.fromEntries(filters.map((btn) => [btn.getAttribute('data-log-filter'), btn.querySelector('.count-pill')]));
  const readAttr = (name) => {
    const n = Number.parseInt((root?.getAttribute(name) || '0').trim(), 10);
    return Number.isFinite(n) && n >= 0 ? n : 0;
  };
  // Authoritative category totals from the database — never derived from paginated rows.
  let totals = {
    all: readAttr('data-log-total-all'),
    transaction: readAttr('data-log-total-transaction'),
    audit: readAttr('data-log-total-audit'),
    error: readAttr('data-log-total-error')
  };
  let kind = 'all';
  let hasMore = scroller?.getAttribute('data-log-more') === '1';
  let loading = false;
  let generation = 0;
  const showActions = scroller?.getAttribute('data-log-actions') === '1' ? '1' : '0';
  const table = document.getElementById('logsTable');
  const rows = () => Array.from(document.querySelectorAll('#logRows tr[data-log-row]'));
  const selectedTotal = () => {
    if (kind === 'transaction') return totals.transaction;
    if (kind === 'audit') return totals.audit;
    if (kind === 'error') return totals.error;
    return totals.all;
  };
  const setPills = () => {
    Object.entries(pills).forEach(([key, pill]) => {
      if (!pill) return;
      pill.textContent = String(totals[key] ?? 0);
      pill.hidden = false;
    });
  };
  const applyTotalsFromHeaders = (res) => {
    const parse = (h) => {
      const n = Number.parseInt((res.headers.get(h) || '').trim(), 10);
      return Number.isFinite(n) && n >= 0 ? n : null;
    };
    const txn = parse('X-Log-Count-Transaction');
    const audit = parse('X-Log-Count-Audit');
    const error = parse('X-Log-Count-Error');
    const all = parse('X-Log-Count-All');
    if (txn === null || audit === null || error === null) return;
    totals = {
      transaction: txn,
      audit: audit,
      error: error,
      all: all ?? (txn + audit + error)
    };
    root?.setAttribute('data-log-total-all', String(totals.all));
    root?.setAttribute('data-log-total-transaction', String(totals.transaction));
    root?.setAttribute('data-log-total-audit', String(totals.audit));
    root?.setAttribute('data-log-total-error', String(totals.error));
  };
  // Show ACTIONS only when at least one visible row has a real button (Open / Retry / Resolve).
  const syncActionsColumn = () => {
    if (!table || showActions !== '1') return;
    const visible = rows().filter((tr) => !tr.hidden);
    const has = visible.some((tr) => tr.getAttribute('data-log-has-action') === '1');
    table.classList.toggle('is-actions-hidden', !has);
    const cols = has ? 5 : 4;
    table.querySelectorAll('[data-log-span]').forEach((td) => { td.colSpan = cols; });
  };
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    let wrongKind = 0;
    rows().forEach((tr) => {
      const rowKind = tr.getAttribute('data-log-kind') || '';
      const text = (tr.getAttribute('data-log-text') || '').toLowerCase();
      const kindOk = kind === 'all' || rowKind === kind;
      if (!kindOk) wrongKind++;
      const show = kindOk && (!q || text.includes(q));
      tr.hidden = !show;
      if (show) visible++;
    });
    if (wrongKind > 0) {
      console.warn('Logs: ignoring ' + wrongKind + ' row(s) that do not match selected kind ' + kind);
    }
    if (emptyRow) {
      emptyRow.hidden = visible > 0;
      const msg = emptyRow.querySelector('[data-log-empty-msg]') || emptyRow.querySelector('td');
      if (msg) {
        if (q) msg.textContent = 'No logs match that filter.';
        else if (kind === 'error') msg.textContent = 'No error logs.';
        else if (kind === 'audit') msg.textContent = 'No audit logs.';
        else if (kind === 'transaction') msg.textContent = 'No transaction logs.';
        else msg.textContent = 'No logs yet.';
      }
    }
    // Summary: category total from DB; when searching, show matches among currently loaded rows.
    const summary = q ? visible : selectedTotal();
    if (count) count.textContent = `${summary} record${summary === 1 ? '' : 's'}`;
    setPills();
    syncActionsColumn();
  };
  const cursorFrom = (tr) => ({
    before: tr?.getAttribute('data-log-at') || '',
    beforeKind: tr?.getAttribute('data-log-kind') || '',
    beforeId: tr?.getAttribute('data-log-id') || '0'
  });
  const loadMore = async (reset) => {
    if ((loading && !reset) || (!hasMore && !reset)) return 0;
    const gen = reset ? ++generation : generation;
    loading = true;
    if (loadingRow) loadingRow.hidden = false;
    const last = rows().at(-1);
    const cursor = reset ? { before: '', beforeKind: '', beforeId: '0' } : cursorFrom(last);
    if (reset) {
      rows().forEach((tr) => tr.remove());
      document.querySelector('[data-log-empty]')?.remove();
      hasMore = true;
    }
    const url = new URL(location.pathname, location.origin);
    url.searchParams.set('handler', 'More');
    url.searchParams.set('kind', kind);
    url.searchParams.set('actions', showActions);
    if (cursor.before) {
      url.searchParams.set('before', cursor.before);
      url.searchParams.set('beforeKind', cursor.beforeKind);
      url.searchParams.set('beforeId', cursor.beforeId);
    }
    let added = 0;
    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } });
      const html = (await res.text()).trim();
      // Ignore stale responses after a newer tab switch.
      if (gen !== generation) return 0;
      applyTotalsFromHeaders(res);
      hasMore = res.headers.get('X-Has-More') === '1';
      if (html && loadingRow) loadingRow.insertAdjacentHTML('beforebegin', html);
      added = html ? 1 : 0;
      if (!html) hasMore = false;
    } catch {
      if (gen === generation) hasMore = false;
    } finally {
      if (gen === generation) {
        loading = false;
        if (loadingRow) loadingRow.hidden = true;
        apply();
      }
    }
    return added;
  };
  const fill = async () => {
    let guard = 0;
    while (hasMore && scroller && scroller.scrollHeight <= scroller.clientHeight + 8 && guard < 8) {
      guard++;
      const added = await loadMore(false);
      if (!added) break;
    }
  };
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.getAttribute('data-log-filter') || 'all';
      if (next === kind && rows().length > 0) {
        filters.forEach((item) => item.classList.toggle('is-active', item === btn));
        apply();
        return;
      }
      kind = next;
      filters.forEach((item) => item.classList.toggle('is-active', item === btn));
      // Show the authoritative total immediately while the filtered page loads.
      apply();
      loadMore(true).then(fill);
    });
  });
  search?.addEventListener('input', apply);
  search?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== 'Escape') return;
    e.preventDefault();
    if (e.key === 'Escape') search.value = '';
    apply();
  });
  scroller?.addEventListener('scroll', () => {
    if (scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 48) return;
    loadMore(false).then(fill);
  });
  setPills();
  apply();
  const hashKind = { 'error-logs': 'error', 'audit-logs': 'audit', 'history-transaction-logs': 'transaction' };
  const hashed = hashKind[(location.hash || '').replace(/^#/, '')];
  if (hashed) document.querySelector(`[data-log-filter="${hashed}"]`)?.click();
  else fill();
})();
</script>
