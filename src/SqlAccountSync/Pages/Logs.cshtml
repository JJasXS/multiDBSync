@page "/logs"
@model SqlAccountSync.Pages.LogsModel
@{
    ViewData["Title"] = "Logs";
}

<div class="logs-page">
    <details class="card txn-history-dropdown" id="history-transaction-logs">
        <summary class="txn-history-summary">
            <span class="txn-history-title">History Transaction Logs</span>
            <span class="count-pill" aria-label="@Model.Transactions.Count records">@Model.Transactions.Count</span>
        </summary>
        <div class="txn-history-body">
            @if (Model.Transactions.Count == 0)
            {
                <p class="empty">No intercompany transactions yet.</p>
            }
            else
            {
                <div class="table-wrap push-jobs-table-wrap">
                    <table>
                        <thead><tr><th>ID</th><th>Type</th><th>Source → Destination</th><th>Status</th><th class="col-actions"></th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            var srcLabel = $"{t.SourceName} {t.SrcDocType} {t.SrcDocNo}".Trim();
                            var dstLabel = $"{t.DestName} {t.DstDocType} {t.DstDocNo}".Trim();
                            var routeTitle = $"{srcLabel} → {dstLabel}";
                            <tr>
                                <td><a asp-page="/Transactions/Details" asp-route-id="@t.TxnPk">@t.TxnId</a></td>
                                <td>@SyncDisplayNames.TxnType(t.TxnTypeCode)</td>
                                <td>
                                    <span class="route-cell cell-truncate" title="@routeTitle">
                                        <span class="route-src">@srcLabel</span>
                                        <span class="route-arrow" aria-hidden="true">→</span>
                                        <span class="route-dst">@dstLabel</span>
                                    </span>
                                </td>
                                <td><span class="badge badge-@(t.Status.ToLowerInvariant())">@t.Status</span></td>
                                <td class="col-actions">
                                    @if (t.Status is not "COMPLETED")
                                    {
                                        <form method="post" asp-page-handler="Retry" asp-route-txnPk="@t.TxnPk"><button class="btn small" type="submit">Retry</button></form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>

    <details class="card txn-history-dropdown" id="audit-logs">
        <summary class="txn-history-summary">
            <span class="txn-history-title">Audit Logs</span>
            <span class="count-pill" aria-label="@Model.Audits.Count records">@Model.Audits.Count</span>
        </summary>
        <div class="txn-history-body">
            @if (Model.Audits.Count == 0)
            {
                <p class="empty">No audit logs yet.</p>
            }
            else
            {
                <div class="table-wrap push-jobs-table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Result</th><th class="col-actions"></th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Audits)
                        {
                            var a = row.Entry;
                            var badge = SyncDisplayNames.AuditResultBadgeClass(row.DisplayResult);
                            <tr>
                                <td>@a.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@a.UserEmail</td>
                                <td>@SyncDisplayNames.AuditAction(a.Action)</td>
                                <td>@(string.IsNullOrWhiteSpace(a.Entity) ? "—" : SyncDisplayNames.TxnType(a.Entity))</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(row.LinkUrl))
                                    {
                                        <a href="@row.LinkUrl">@a.RecordId</a>
                                    }
                                    else
                                    {
                                        @a.RecordId
                                    }
                                </td>
                                <td>
                                    <span class="badge @badge" title="@row.StatusDetail">@row.DisplayResult</span>
                                </td>
                                <td class="col-actions">
                                    @if (!string.IsNullOrWhiteSpace(row.LinkUrl))
                                    {
                                        <a class="btn small secondary" href="@row.LinkUrl">@row.LinkLabel</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>

    <details class="card txn-history-dropdown" id="error-logs">
        <summary class="txn-history-summary">
            <span class="txn-history-title">Error Logs</span>
            <span class="count-pill" aria-label="@Model.Errors.Count records">@Model.Errors.Count</span>
        </summary>
        <div class="txn-history-body">
            <p class="muted txn-history-note">Stack traces are stored for administrators and are not shown here.</p>
            @if (Model.Errors.Count == 0)
            {
                <p class="empty">No error logs yet.</p>
            }
            else
            {
                <div class="table-wrap push-jobs-table-wrap">
                    <table>
                        <thead><tr><th>When</th><th>Type</th><th>Message</th><th>Resolved</th><th class="col-actions"></th></tr></thead>
                        <tbody>
                        @foreach (var e in Model.Errors)
                        {
                            <tr>
                                <td>@e.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@e.ErrorType</td>
                                <td><span class="cell-truncate" title="@e.UserMessage">@e.UserMessage</span></td>
                                <td>@(e.Resolved ? "Yes" : "No")</td>
                                <td class="col-actions">
                                    @if (!e.Resolved && Model.CanManage)
                                    {
                                        <form method="post" asp-page-handler="ResolveError" asp-route-id="@e.ErrorId">
                                            <button class="btn small secondary" type="submit">Resolve</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>
</div>

<script>
(() => {
  var id = (location.hash || '').replace(/^#/, '');
  if (!id) return;
  var el = document.getElementById(id);
  if (el && el.tagName === 'DETAILS') {
    el.open = true;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
})();
</script>
