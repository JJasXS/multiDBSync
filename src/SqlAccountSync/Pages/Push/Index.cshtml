@page "/push"
@model SqlAccountSync.Pages.Push.IndexModel
@{
    ViewData["Title"] = "Synchronization";
    var entities = PushableEntityCodes.Push;
    var isAccount = Model.IsAccountEntity;
    var recordsTitle = isAccount ? "Accounts" : Model.EntityCode == EntityCodes.Supplier ? "Suppliers" : "Customers";
    var partyColumns = isAccount ? 0 : 4;
    var codeColumns = 2 + partyColumns + (Model.CanOperate ? 1 : 0) + (isAccount && Model.CanOperate ? 1 : 0);
    string PartyField(MasterRecord row, string key) =>
        row.Fields.TryGetValue(key, out var value) ? value : "";
    var selectedRecordCount = Model.Records.Count(r => Model.SelectedCodes.Contains(r.Code, StringComparer.OrdinalIgnoreCase));
    var selectedDbCount = Model.TargetSubs.Count(s => Model.SelectedSubDbIds.Contains(s.DbId));
}

@if (Model.FlashToast is not null)
{
    <partial name="_FlashToast" model="Model.FlashToast" />
}

<div class="card sync-page-card">
    <div class="card-head master-section-head">
        <div class="master-section-current">
            <span class="master-section-label">Multi Push</span>
            <span class="master-section-hint">Multiple rows</span>
        </div>
    </div>

    <div class="push-workspace multi-push">
        <form method="get" class="push-source-form">
            <input type="hidden" name="tab" value="push" />
            <div class="route-fields push-route-fields">
                <div class="route-field">
                    <label for="pushSourceDb">Source</label>
                    <select id="pushSourceDb" name="SourceDbId" onchange="this.form.submit()">
                        @foreach (var d in Model.SourceDatabases)
                        {
                            <option value="@d.DbId" selected="@(d.DbId == Model.SourceDbId)">@d.DisplayName</option>
                        }
                    </select>
                </div>
                <span class="route-arrow push-route-arrow" aria-hidden="true">→</span>
                <div class="route-field">
                    <label for="pushEntityCode">Entity</label>
                    <select id="pushEntityCode" name="EntityCode" onchange="this.form.submit()">
                        @foreach (var e in entities)
                        {
                            <option value="@e" selected="@(e == Model.EntityCode)">@e</option>
                        }
                    </select>
                </div>
            </div>
        </form>

        <form id="pushForm" method="post" asp-page-handler="Push">
            <input type="hidden" name="Tab" value="push" />
            <input type="hidden" asp-for="SourceDbId" />
            <input type="hidden" asp-for="EntityCode" />

            <div class="push-layout">
                <section class="push-panel" id="pushCodesPanel">
                    <div class="push-panel-head">
                        <div>
                            <h3>@recordsTitle</h3>
                            <p class="push-panel-count" data-push-record-count>@Model.Records.Count records · @selectedRecordCount selected</p>
                        </div>
                        <div class="push-panel-search">
                            <label class="sr-only" for="pushCodeSearch">@(isAccount ? "Search code or description" : "Search code, name, phone, or email")</label>
                            <input id="pushCodeSearch" type="search" placeholder="@(isAccount ? "Search code or description..." : "Search code, name, phone, or email...")"
                                   autocomplete="off" spellcheck="false" />
                        </div>
                    </div>
                    <div class="push-panel-table-wrap">
                    <table class="push-panel-table" id="pushCodesTable">
                        <thead>
                            @if (Model.Records.Count > 0)
                            {
                                <tr>
                                    @if (Model.CanOperate)
                                    {
                                        <th class="col-check">
                                            <input type="checkbox" data-check-all="master-codes" aria-label="Select all records" />
                                        </th>
                                    }
                                    <th>Code</th>
                                    <th>Description</th>
                                    @if (!isAccount)
                                    {
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th>Attention</th>
                                        <th>Area</th>
                                    }
                                    @if (isAccount && Model.CanOperate)
                                    {
                                        <th class="col-actions">Actions</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @if (Model.Records.Count == 0)
                            {
                                <tr>
                                    <td colspan="@codeColumns" class="empty">No records. Pick source and entity.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.Records)
                                {
                                    var selected = Model.SelectedCodes.Contains(r.Code, StringComparer.OrdinalIgnoreCase);
                                    var indent = r.Fields.TryGetValue("indent", out var ind) ? ind : "";
                                    var desc = string.IsNullOrEmpty(indent) ? r.Description : indent + r.Description;
                                    var phone = PartyField(r, "phone");
                                    var email = PartyField(r, "email");
                                    var attention = PartyField(r, "attention");
                                    var area = PartyField(r, "area");
                                    <tr data-push-code="@r.Code" data-push-desc="@r.Description" data-push-extra="@($"{phone} {email} {attention} {area}")">
                                        @if (Model.CanOperate)
                                        {
                                            <td class="col-check">
                                                <input type="checkbox" name="SelectedCodes" value="@r.Code" data-check-group="master-codes"
                                                       @(selected ? "checked" : null) />
                                            </td>
                                        }
                                        <td class="code-cell">@r.Code</td>
                                        <td><span class="cell-truncate" title="@r.Description">@desc</span></td>
                                        @if (!isAccount)
                                        {
                                            <td class="push-party-col" title="@phone">@phone</td>
                                            <td class="push-party-col" title="@email">@email</td>
                                            <td class="push-party-col" title="@attention">@attention</td>
                                            <td class="push-party-col" title="@area">@area</td>
                                        }
                                        @if (isAccount && Model.CanOperate)
                                        {
                                            <td class="col-actions">
                                                <button type="button"
                                                        class="accounts-icon-btn accounts-status-edit"
                                                        title="Edit account"
                                                        aria-label="Edit @r.Code"
                                                        data-accounts-edit
                                                        data-code="@r.Code"
                                                        data-description="@r.Description"
                                                        data-description2="@(r.Fields.TryGetValue("description2", out var description2) ? description2 : null)"
                                                        data-acctype="@(r.Fields.TryGetValue("acctype", out var accType) ? accType : null)"
                                                        data-specialacctype="@(r.Fields.TryGetValue("specialacctype", out var specialAccType) ? specialAccType : null)"
                                                        data-tax="@(r.Fields.TryGetValue("tax", out var tax) ? tax : null)"
                                                        data-cashflowtype="@(r.Fields.TryGetValue("cashflowtype", out var cashFlowType) ? cashFlowType : null)"
                                                        data-sic="@(r.Fields.TryGetValue("sic", out var sic) ? sic : null)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                                    </svg>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                                <tr id="pushCodeSearchEmpty" class="accounts-search-empty" hidden>
                                    <td colspan="@codeColumns" class="empty">No records match that search.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </section>

                <section class="push-panel">
                    <div class="push-panel-head">
                        <div>
                            <h3>Target databases</h3>
                            <p class="push-panel-count" data-push-db-count data-push-db-total="@Model.TargetSubs.Count">@Model.TargetSubs.Count databases · @selectedDbCount selected</p>
                        </div>
                    </div>
                    <div class="push-panel-table-wrap">
                    <table class="push-panel-table">
                        <thead>
                            @if (Model.TargetSubs.Count > 0)
                            {
                                <tr>
                                    @if (Model.CanOperate)
                                    {
                                        <th class="col-check">
                                            <input type="checkbox" data-check-all="sub-dbs" aria-label="Select all target databases" />
                                        </th>
                                    }
                                    <th>Database</th>
                                    <th>Code</th>
                                    <th>Note</th>
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @if (Model.TargetSubs.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(Model.CanOperate ? 4 : 3)" class="empty">No targets for this source.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var s in Model.TargetSubs)
                                {
                                    var selected = Model.SelectedSubDbIds.Contains(s.DbId);
                                    Model.TargetEntityHints.TryGetValue(s.DbId, out var hint);
                                    <tr>
                                        @if (Model.CanOperate)
                                        {
                                            <td class="col-check">
                                                <input type="checkbox" name="SelectedSubDbIds" value="@s.DbId" data-check-group="sub-dbs"
                                                       @(selected ? "checked" : null) />
                                            </td>
                                        }
                                        <td class="push-target-name">@s.DisplayName</td>
                                        <td class="muted">@s.DbCode</td>
                                        <td class="push-target-note muted">@hint</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    </div>
                </section>
            </div>
            @if (Model.CanOperate)
            {
                <div class="push-actions">
                    <button type="button" class="btn btn-ghost" data-push-clear>Clear selection</button>
                    <button class="btn" type="submit" data-push-submit
                            data-confirm="Push selected records to the selected target databases?"
                            data-confirm-title="Confirm push"
                            data-confirm-ok="Push">@(selectedRecordCount > 0 ? $"Push {selectedRecordCount} record{(selectedRecordCount == 1 ? "" : "s")} →" : "Push selected →")</button>
                </div>
            }
        </form>
        @if (isAccount && Model.CanOperate)
        {
            <dialog id="accountsEditModal" class="accounts-modal">
                <form method="post" asp-page-handler="SaveEdit" class="accounts-modal-form">
                    <input type="hidden" name="Tab" value="push" />
                    <input type="hidden" name="SourceDbId" value="@Model.SourceDbId" />
                    <input type="hidden" name="EntityCode" value="ACCOUNT" />
                    <div class="accounts-modal-head">
                        <h3>Edit account</h3>
                        <button type="button" class="accounts-modal-close" data-accounts-edit-close aria-label="Close">&times;</button>
                    </div>
                    <div class="accounts-modal-body">
                        <div class="field">
                            <label for="EditCode">Code</label>
                            <input id="EditCode" name="EditCode" class="input-readonly" readonly />
                        </div>
                        <div class="field">
                            <label for="EditDescription">Description</label>
                            <input id="EditDescription" name="EditDescription" maxlength="200" required />
                        </div>
                        <div class="field">
                            <label for="EditDescription2">Description 2</label>
                            <input id="EditDescription2" name="EditDescription2" maxlength="200" />
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label for="EditAccType">Acc type</label>
                                <input id="EditAccType" name="EditAccType" maxlength="20" />
                            </div>
                            <div class="field">
                                <label for="EditSpecialAccType">Special acc type</label>
                                <input id="EditSpecialAccType" name="EditSpecialAccType" maxlength="20" />
                            </div>
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label for="EditTax">Tax</label>
                                <input id="EditTax" name="EditTax" maxlength="40" />
                            </div>
                            <div class="field">
                                <label for="EditCashFlowType">Cash flow type</label>
                                <input id="EditCashFlowType" name="EditCashFlowType" type="number" />
                            </div>
                        </div>
                        <div class="field">
                            <label for="EditSic">SIC</label>
                            <input id="EditSic" name="EditSic" maxlength="40" />
                        </div>
                        <p class="muted accounts-modal-hint">Saves on master via SQL Acc API, then queues updates to linked subs.</p>
                    </div>
                    <div class="accounts-modal-actions">
                        <button type="button" class="btn btn-ghost" data-accounts-edit-close>Cancel</button>
                        <button type="submit" class="btn">Save &amp; push update</button>
                    </div>
                </form>
            </dialog>
        }
    </div>

<script>
(() => {
  const search = document.getElementById('pushCodeSearch');
  const emptyRow = document.getElementById('pushCodeSearchEmpty');
  const form = document.getElementById('pushForm');
  const recordCount = document.querySelector('[data-push-record-count]');
  const dbCount = document.querySelector('[data-push-db-count]');
  const submit = document.querySelector('[data-push-submit]');
  if (!form) return;

  const rows = () => Array.from(document.querySelectorAll('#pushCodesTable tbody tr[data-push-code]'));
  const checkedCount = (group) => form.querySelectorAll(`input[data-check-group="${group}"]:checked`).length;
  const word = (n, one, many) => `${n} ${n === 1 ? one : many}`;
  const refresh = (visible) => {
    const records = checkedCount('master-codes');
    const dbs = checkedCount('sub-dbs');
    const dbTotal = Number(dbCount?.getAttribute('data-push-db-total') || 0);
    if (recordCount) recordCount.textContent = `${word(visible, 'record', 'records')} · ${records} selected`;
    if (dbCount) dbCount.textContent = `${word(dbTotal, 'database', 'databases')} · ${dbs} selected`;
    if (submit) submit.textContent = records > 0 ? `Push ${word(records, 'record', 'records')} →` : 'Push selected →';
  };
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    rows().forEach((tr) => {
      const code = (tr.getAttribute('data-push-code') || '').toLowerCase();
      const desc = (tr.getAttribute('data-push-desc') || '').toLowerCase();
      const extra = (tr.getAttribute('data-push-extra') || '').toLowerCase();
      const show = !q || code.includes(q) || desc.includes(q) || extra.includes(q);
      tr.hidden = !show;
      if (show) visible++;
    });
    if (emptyRow) emptyRow.hidden = visible > 0 || rows().length === 0;
    refresh(visible);
  };

  search?.addEventListener('input', apply);
  search?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== 'Escape') return;
    e.preventDefault();
    if (e.key === 'Escape') search.value = '';
    apply();
  });
  form.addEventListener('change', apply);
  document.querySelector('[data-push-clear]')?.addEventListener('click', () => {
    form.querySelectorAll('input[type="checkbox"]').forEach((cb) => { cb.checked = false; });
    apply();
  });
  apply();
})();
</script>
@if (isAccount && Model.CanOperate)
{
<script>
(() => {
  const modal = document.getElementById('accountsEditModal');
  if (!modal) return;
  const set = (id, value) => {
    const el = document.getElementById(id);
    if (el) el.value = value ?? '';
  };
  document.querySelectorAll('[data-accounts-edit]').forEach(btn => {
    btn.addEventListener('click', () => {
      set('EditCode', btn.getAttribute('data-code'));
      set('EditDescription', btn.getAttribute('data-description'));
      set('EditDescription2', btn.getAttribute('data-description2'));
      set('EditAccType', btn.getAttribute('data-acctype'));
      set('EditSpecialAccType', btn.getAttribute('data-specialacctype'));
      set('EditTax', btn.getAttribute('data-tax'));
      set('EditCashFlowType', btn.getAttribute('data-cashflowtype') || '0');
      set('EditSic', btn.getAttribute('data-sic'));
      if (typeof modal.showModal === 'function') modal.showModal();
      else modal.setAttribute('open', '');
    });
  });
  const close = () => {
    if (typeof modal.close === 'function') modal.close();
    else modal.removeAttribute('open');
  };
  document.querySelectorAll('[data-accounts-edit-close]').forEach(btn => btn.addEventListener('click', close));
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
})();
</script>
}
</div>
