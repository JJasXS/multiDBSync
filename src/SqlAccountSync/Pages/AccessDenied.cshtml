@page
@model SqlAccountSync.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="card" style="max-width:32rem;margin:2rem auto">
    <div class="card-head"><h3>Access denied</h3></div>
    <p class="muted">Your account is signed in, but this page requires an ADMIN role.</p>
    <p class="muted">Ask an administrator to raise your role under Settings → User Management, then refresh.</p>
    <p style="margin-top:1.25rem">
        <a class="btn" asp-page="/Index">Back to dashboard</a>
        <a class="btn secondary" asp-page="/Settings/Index">Settings</a>
    </p>
</div>
