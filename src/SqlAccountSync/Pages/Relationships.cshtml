@page
@model SqlAccountSync.Pages.RelationshipsModel
@{
    ViewData["Title"] = "Master / Sub relationships";
    var masters = Model.Databases.Where(d => d.DbRole is "MASTER" or "BOTH").ToList();
    var subs = Model.Databases.Where(d => d.DbRole is "SUB" or "BOTH").ToList();
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="flash @(Model.Error ? "flash-err" : "flash-ok")">@Model.Message</div>
}
<div class="card">
    @foreach (var m in masters)
    {
        <div>
            <strong>@m.DisplayName</strong>
            <span class="badge badge-master">MASTER</span>
            <span class="badge badge-@(m.ConnStatus == "ONLINE" ? "online" : "offline")">@m.ConnStatus</span>
        </div>
        <div class="tree">
            @foreach (var link in Model.Links.Where(l => l.MasterDbId == m.DbId))
            {
                var sub = Model.Databases.FirstOrDefault(d => d.DbId == link.SubDbId);
                <div class="node">
                    └── SUB @link.SubName
                    @if (sub is not null)
                    {
                        <span class="badge badge-@(sub.ConnStatus == "ONLINE" ? "online" : "offline")">@sub.ConnStatus</span>
                    }
                </div>
            }
        </div>
    }
</div>
@if (Model.IsAdmin)
{
    <div class="card">
        <h3>Add link</h3>
        <form method="post" class="form-grid">
            <div>
                <label>Master</label>
                <select asp-for="MasterDbId">
                    @foreach (var d in masters) { <option value="@d.DbId">@d.DisplayName (@d.DbRole)</option> }
                </select>
            </div>
            <div>
                <label>Sub</label>
                <select asp-for="SubDbId">
                    @foreach (var d in subs) { <option value="@d.DbId">@d.DisplayName (@d.DbRole)</option> }
                </select>
            </div>
            <div><button class="btn" type="submit">Link</button></div>
        </form>
    </div>
}
