@page
@model SqlAccountSync.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var activeAdminCount = Model.Users.Count(u => u.IsActive && AppRoles.Rank(u.Role) >= AppRoles.Rank(AppRoles.Admin));
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="flash @(Model.Error ? "flash-err" : "flash-ok")">@Model.Message</div>
}
<div class="users-page">
    <div class="card users-form-card">
        <div class="card-head">
            <h3>Add user</h3>
        </div>
        <p class="muted users-form-lede">Add a SYNC user (role + access). Their email must also exist on LOGIN.FDB <code>SY_USER.EMAIL</code> to receive an OTP.</p>
        @if (!Model.IsAdmin)
        {
            <p class="muted users-form-lede">Only an ADMIN can add users or turn accounts on and off.</p>
        }
        else
        {
        <form method="post" class="users-form">
            <div class="users-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" required placeholder="name@company.com" autocomplete="email" />
            </div>
            <div class="users-field">
                <label asp-for="DisplayName">Name</label>
                <input asp-for="DisplayName" required placeholder="Display name" autocomplete="name" />
            </div>
            <div class="users-field users-field-role">
                <label asp-for="Role">Role</label>
                <select asp-for="Role">
                    <option>ADMIN</option>
                    <option>VIEWER</option>
                </select>
            </div>
            <div class="users-form-actions">
                <button class="btn" type="submit">Save</button>
            </div>
        </form>
        }
    </div>

    <div class="card users-list-card">
        <div class="card-head">
            <h3>Users</h3>
        </div>
        <p class="muted lede">An ADMIN turns accounts on or off. You cannot turn off your own account, and the last ADMIN must stay on.</p>
        @if (Model.Users.Count == 0)
        {
            <p class="empty">No users yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th></tr></thead>
                    <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var isAdminRole = AppRoles.Rank(u.Role) >= AppRoles.Rank(AppRoles.Admin);
                        var isSelf = u.UserId == Model.CurrentUserId
                            || string.Equals(u.Email.Trim(), Model.CurrentEmail.Trim(), StringComparison.OrdinalIgnoreCase);
                        var isLastAdmin = u.IsActive && isAdminRole && activeAdminCount <= 1;
                        var locked = u.IsActive && (isSelf || isLastAdmin);
                        var lockNote = isSelf ? "Your account" : "Last admin";
                        var lockTitle = isSelf
                            ? "You cannot turn off your own account."
                            : "The last ADMIN must stay on.";
                        <tr>
                            <td>@u.DisplayName</td>
                            <td>@u.Email</td>
                            <td>@u.Role</td>
                            <td>
                                @if (!Model.IsAdmin)
                                {
                                    <span class="badge @(u.IsActive ? "badge-online" : "badge-disabled")">
                                        @(u.IsActive ? "On" : "Off")
                                    </span>
                                }
                                else if (locked)
                                {
                                    <span class="user-switch is-on is-locked" title="@lockTitle">
                                        <span class="user-switch-track" aria-hidden="true"><span class="user-switch-knob"></span></span>
                                        <span class="user-switch-label">On</span>
                                    </span>
                                    <span class="muted user-switch-note">@lockNote</span>
                                }
                                else if (u.IsActive)
                                {
                                    <form method="post" class="user-switch-form" asp-page-handler="SetActive" asp-route-id="@u.UserId">
                                        <input type="hidden" name="active" value="false" />
                                        <button class="user-switch is-on" type="submit" aria-pressed="true"
                                                data-confirm="Turn off @u.DisplayName? They will not be able to sign in."
                                                data-confirm-title="Turn off user"
                                                data-confirm-ok="Turn off"
                                                data-confirm-danger>
                                            <span class="user-switch-track" aria-hidden="true"><span class="user-switch-knob"></span></span>
                                            <span class="user-switch-label">On</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" class="user-switch-form" asp-page-handler="SetActive" asp-route-id="@u.UserId">
                                        <input type="hidden" name="active" value="true" />
                                        <button class="user-switch" type="submit" aria-pressed="false">
                                            <span class="user-switch-track" aria-hidden="true"><span class="user-switch-knob"></span></span>
                                            <span class="user-switch-label">Off</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
