@page
@model SqlAccountSync.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}
<div class="settings-page">
    <div class="settings-hero">
        <div class="settings-hero-copy">
            <h3 class="settings-hero-title">Settings</h3>
            <p class="settings-hero-sub muted">Manage your system preferences and configuration</p>
        </div>
        <div class="settings-search-wrap">
            <label class="sr-only" for="settingsSearch">Search settings</label>
            <input id="settingsSearch" class="settings-search" type="search"
                   placeholder="Search settings..." autocomplete="off" />
        </div>
    </div>

    <div class="settings-list" data-settings-list>
        @foreach (var item in Model.Items)
        {
            <partial name="_SettingsRow" model="item" />
        }
        <p class="settings-empty empty" data-settings-empty hidden>No settings found</p>
    </div>
</div>
