@page
@model SqlAccountSync.Pages.Settings.AuditModel
@{
    ViewData["Title"] = "Audit logs";
}
<div class="settings-section">
    <div class="settings-section-nav">
        <a class="settings-back" href="/Settings">← Back to Settings</a>
    </div>

    <div class="card">
        <div class="card-head">
            <h3>Audit logs</h3>
        </div>
        @if (Model.Audits.Count == 0)
        {
            <p class="empty">No audit logs yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Result</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.Audits)
                    {
                        <tr>
                            <td>@a.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.UserEmail</td>
                            <td>@a.Action</td>
                            <td>@a.Entity</td>
                            <td>@a.RecordId</td>
                            <td>@a.Result</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
