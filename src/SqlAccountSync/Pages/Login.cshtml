@page
@model SqlAccountSync.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap card">
    <div class="login-head">
        <h2>SQL Account Sync</h2>
        <p class="muted">Secure sign-in · one-time code</p>
    </div>
    <div class="login-body">
        <p class="muted">Enter your email to receive a one-time sign-in code. Passwords are not stored.</p>
        @if (Model.ShowLocalDevHint)
        {
            <p class="hint">Local development (no central database): email <code>admin@localhost</code>, code <code>123456</code>.</p>
        }
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="flash @(Model.Sent ? "flash-ok" : "flash-err")">@Model.Message</div>
        }
        <form method="post" asp-page-handler="Send">
            <label>Email</label>
            <input asp-for="Email" type="email" required />
            <button class="btn" type="submit">Send code</button>
        </form>
        <form method="post" asp-page-handler="Verify">
            <input type="hidden" asp-for="Email" />
            <label>Code</label>
            <input asp-for="Code" />
            <button class="btn secondary" type="submit">Sign in</button>
        </form>
    </div>
</div>
