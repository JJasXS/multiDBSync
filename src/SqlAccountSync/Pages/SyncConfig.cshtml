@page
@model SqlAccountSync.Pages.SyncConfigModel
@{
    ViewData["Title"] = "Sync configuration";
    string DirLabel(string d) => d switch
    {
        "MASTER_TO_SUB" => "Master → Sub",
        "SUB_TO_MASTER" => "Sub → Master",
        _ => d
    };
}
<div class="sync-config">
    <div class="sync-config-hero">
        <div>
            <h3 class="sync-config-title">Sync configuration</h3>
            <p class="muted sync-config-sub">Choose a Master → Sub link, then enable entities and optional per-record scopes.</p>
        </div>
        @if (Model.Links.Count > 0)
        {
            <a class="btn secondary" asp-page="/Databases/Index" asp-route-tab="relationships">Manage links</a>
        }
    </div>

    <div class="card sync-config-link">
        <div class="card-head">
            <h3>Active link</h3>
        </div>
        @if (Model.Links.Count == 0)
        {
            <p class="empty">No Master → Sub relationships yet. Create a link before you can add sync rules.</p>
            <p class="empty-actions">
                @if (Model.DatabaseCount < 2)
                {
                    <a class="btn" asp-page="/Databases/Edit">Add databases</a>
                    <a class="btn secondary" asp-page="/Databases/Index">View databases</a>
                }
                else
                {
                    <a class="btn" asp-page="/Databases/Index" asp-route-tab="relationships">Add a Master / Sub link</a>
                }
            </p>
        }
        else
        {
            <form method="get" class="sync-config-link-form">
                <div class="sync-config-link-field">
                    <label for="linkId">Master → Sub</label>
                    <select id="linkId" name="linkId" onchange="this.form.submit()">
                        @foreach (var l in Model.Links)
                        {
                            <option value="@l.LinkId" selected="@(l.LinkId == Model.LinkId)">@l.MasterName → @l.SubName</option>
                        }
                    </select>
                </div>
                <p class="muted sync-config-hint">Rules and record scopes apply only to this link.</p>
            </form>
        }
    </div>

    <div class="sync-config-grid">
        <div class="card sync-config-rules">
            <div class="card-head">
                <h3>Entity rules</h3>
                @if (Model.Rules.Count > 0)
                {
                    <span class="muted">@Model.Rules.Count rule@(Model.Rules.Count == 1 ? "" : "s")</span>
                }
            </div>
            @if (Model.Links.Count == 0)
            {
                <p class="empty">Rules appear here after a Master → Sub link exists.</p>
                <p class="empty-actions">
                    @if (Model.DatabaseCount < 2)
                    {
                        <a class="btn" asp-page="/Databases/Edit">Add databases</a>
                    }
                    else
                    {
                        <a class="btn" asp-page="/Databases/Index" asp-route-tab="relationships">Go to relationships</a>
                    }
                </p>
            }
            else if (Model.Rules.Count == 0)
            {
                <p class="empty">No rules for this link yet. Use <strong>Add or update rule</strong> to enable an entity.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Entity</th>
                                <th>Status</th>
                                <th>Direction</th>
                                <th>Mode</th>
                                <th>Last sync</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.Rules)
                        {
                            <tr>
                                <td>@r.EntityCode</td>
                                <td>
                                    <span class="badge @(r.Enabled ? "badge-online" : "badge-disabled")">
                                        @(r.Enabled ? "Enabled" : "Disabled")
                                    </span>
                                </td>
                                <td>@DirLabel(r.Direction)</td>
                                <td>@r.Mode</td>
                                <td>@(r.LastSyncAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="sync-config-side">
            <div class="card" id="add-rule">
                <div class="card-head">
                    <h3>Add or update rule</h3>
                </div>
                @if (Model.Links.Count == 0 || Model.LinkId == 0)
                {
                    <p class="empty">Select a Master → Sub link first, then enable an entity here.</p>
                }
                else if (!Model.CanManage)
                {
                    <p class="empty">Only a manager or administrator can change rules.</p>
                }
                else
                {
                    <p class="muted lede">Automatic runs from the worker; Manual waits for an operator.</p>
                    <form method="post" asp-page-handler="SaveRule" class="form-stack">
                        <input type="hidden" asp-for="LinkId" />
                        <input type="hidden" asp-for="RuleId" />
                        <div>
                            <label for="EntityCode">Entity</label>
                            <select asp-for="EntityCode" id="EntityCode">
                                <option>ITEM</option>
                                <option>CUSTOMER</option>
                                <option>SUPPLIER</option>
                            </select>
                        </div>
                        <div>
                            <label for="Mode">Mode</label>
                            <select asp-for="Mode" id="Mode">
                                <option>MANUAL</option>
                                <option>AUTOMATIC</option>
                            </select>
                        </div>
                        <div>
                            <label for="Direction">Direction</label>
                            <select asp-for="Direction" id="Direction">
                                <option value="MASTER_TO_SUB">Master → Sub</option>
                                <option value="SUB_TO_MASTER">Sub → Master</option>
                            </select>
                        </div>
                        <label class="check">
                            <input asp-for="Enabled" />
                            <span>Enabled</span>
                        </label>
                        <div>
                            <button class="btn" type="submit">Save rule</button>
                        </div>
                    </form>
                }
            </div>

            <div class="card">
                <div class="card-head">
                    <h3>Per-record scope</h3>
                </div>
                @if (Model.Links.Count == 0 || Model.LinkId == 0)
                {
                    <p class="empty">Select a Master → Sub link first, then limit a rule to specific codes.</p>
                }
                else if (!Model.CanManage)
                {
                    <p class="empty">Only a manager or administrator can change record scope.</p>
                }
                else
                {
                    <p class="muted lede">Optional: limit a saved rule to specific Sub codes.</p>
                    <form method="post" asp-page-handler="SaveScope" class="form-stack">
                        <input type="hidden" asp-for="LinkId" />
                        <div>
                            <label for="RuleId">Rule</label>
                            @if (Model.Rules.Count == 0)
                            {
                                <input asp-for="RuleId" id="RuleId" disabled />
                                <p class="field-hint muted">Save a rule first.</p>
                            }
                            else
                            {
                                <select asp-for="RuleId" id="RuleId">
                                    @foreach (var r in Model.Rules)
                                    {
                                        <option value="@r.RuleId">@r.EntityCode (#@r.RuleId)</option>
                                    }
                                </select>
                            }
                        </div>
                        <div>
                            <label for="RecordCode">Record code</label>
                            <input asp-for="RecordCode" id="RecordCode" placeholder="ITEM001" />
                        </div>
                        <label class="check">
                            <input asp-for="ScopeEnabled" />
                            <span>Enabled for this Sub</span>
                        </label>
                        <div>
                            <button class="btn secondary" type="submit" @(Model.Rules.Count == 0 ? "disabled" : null)>Save scope</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
