@page
@model SqlAccountSync.Pages.IndexModel
@using Microsoft.Extensions.Options
@using SqlAccountSync.Options
@inject IOptions<FeatureOptions> FeatureOptions
@{
    ViewData["Title"] = "Dashboard";
    var showMappingsUi = FeatureOptions.Value.ShowMappingsUi;
    var showSyncConfigUi = FeatureOptions.Value.ShowSyncConfigUi;
}
@if (Model.FlashToast is not null)
{
    <partial name="_FlashToast" model="Model.FlashToast" />
}
<div class="stats">
    <div class="stat"><div class="n">@Model.Databases.Count</div><div class="l">Databases</div></div>
    <div class="stat"><div class="n">@Model.Links.Count</div><div class="l">Relationships</div></div>
    <div class="stat"><div class="n">@Model.Stats.Offline</div><div class="l">Offline</div></div>
    <div class="stat"><div class="n">@Model.Users.Count</div><div class="l">Users</div></div>
</div>
<div class="map-layout">
    <div class="map-layout-left">
        <div class="card">
            <div class="card-head">
                <h3>Databases</h3>
                <details class="kebab">
                    <summary aria-label="Actions">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
                    </summary>
                    <div class="kebab-menu">
                        <a asp-page="/Databases/Index">View</a>
                        @if (Model.IsAdmin)
                        {
                            <a asp-page="/Databases/Create">Add database</a>
                        }
                    </div>
                </details>
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else if (Model.Databases.Count == 0)
            {
                <p class="empty">No companies registered yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Company</th><th>Role</th><th>Status</th><th>Last sync</th></tr></thead>
                        <tbody>
                        @foreach (var d in Model.Databases)
                        {
                            <tr>
                                <td><a asp-page="/Databases/Details" asp-route-id="@d.DbId">@d.DisplayName</a></td>
                                <td><span class="badge badge-@(d.DbRole.ToLowerInvariant())">@d.DbRole</span></td>
                                <td><span class="badge badge-@(d.ConnStatus == "ONLINE" ? "online" : "offline")">@d.ConnStatus</span></td>
                                <td>@(d.LastSyncOk?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <div>
                    <h3>Synchronization jobs</h3>
                    @if (Model.CentralConfigured)
                    {
                        <p class="muted" style="margin:0.25rem 0 0;">
                            Pending @Model.QueueHealth.Pending · Processing @Model.QueueHealth.Processing
                            @if (Model.QueueHealth.Failed > 0)
                            {
                                <text> · Failed @Model.QueueHealth.Failed</text>
                            }
                        </p>
                    }
                </div>
                @if (Model.CanOperate && Model.CentralConfigured)
                {
                    <form method="post" asp-page-handler="StopAllJobs">
                        <button type="submit"
                                class="btn small secondary"
                                @(Model.ActiveJobCount == 0 ? "disabled" : null)
                                data-confirm="Stop all pending, retrying, and processing jobs? Failed history is kept."
                                data-confirm-title="Stop all jobs"
                                data-confirm-ok="Stop all"
                                data-confirm-danger>
                            Stop all
                        </button>
                    </form>
                }
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else if (Model.RecentJobs.Count == 0)
            {
                <p class="empty">No recent jobs.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Job</th><th>Kind</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var j in Model.RecentJobs)
                        {
                            <tr>
                                <td>@j.JobId</td>
                                <td>@SyncDisplayNames.JobKind(j.JobKind, j.DryRun)</td>
                                <td><span class="badge badge-@(j.Status.ToLowerInvariant())">@j.Status</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (showMappingsUi)
        {
        <div class="card">
            <div class="card-head">
                <h3>Mappings</h3>
                <a asp-page="/Mappings/Index" asp-route-entity="ITEM">View</a>
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else
            {
                <p class="muted">@Model.MappedCount mapped · @Model.Conflicts.Count conflict@(Model.Conflicts.Count == 1 ? "" : "s")</p>
                @if (Model.Conflicts.Count == 0)
                {
                    <p class="empty">No mapping conflicts.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Entity</th><th>Master</th><th>Sub</th></tr></thead>
                            <tbody>
                            @foreach (var m in Model.Conflicts.Take(5))
                            {
                                <tr>
                                    <td>@m.EntityCode</td>
                                    <td>@m.MasterCode</td>
                                    <td>@m.SubCode</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
        }

        @if (Model.IsAdmin)
        {
        <div class="card">
            <div class="card-head">
                <h3>Users</h3>
                <a asp-page="/Users/Index">View</a>
            </div>
            @if (Model.Users.Count == 0)
            {
                <p class="empty">No users yet.</p>
            }
            else
            {
                <p class="muted">@Model.Users.Count user@(Model.Users.Count == 1 ? "" : "s")</p>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Name</th><th>Role</th></tr></thead>
                        <tbody>
                        @foreach (var u in Model.Users.Take(8))
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(u.DisplayName) ? u.Email : u.DisplayName)</td>
                                <td>@u.Role</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        }
    </div>

    <div class="map-layout-right">
        @if (showSyncConfigUi)
        {
        <div class="card">
            <div class="card-head">
                <h3>Sync configuration</h3>
                <a asp-page="/SyncConfig">View</a>
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else
            {
                <p class="muted">@Model.EnabledRuleCount enabled rule@(Model.EnabledRuleCount == 1 ? "" : "s")</p>
                @if (Model.Links.Count == 0)
                {
                    <p class="empty">No Master → Sub links yet.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Master</th><th>Sub</th></tr></thead>
                            <tbody>
                            @foreach (var l in Model.Links)
                            {
                                <tr>
                                    <td>@l.MasterName</td>
                                    <td>@l.SubName</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
        }

        <div class="card rel-card">
            @{
                DateTime? relLastChecked = null;
                if (Model.CentralConfigured && Model.Links.Count > 0)
                {
                    var relIds = Model.Links.SelectMany(l => new[] { l.MasterDbId, l.SubDbId }).ToHashSet();
                    var stamps = Model.Databases
                        .Where(d => relIds.Contains(d.DbId) && d.LastConnOk is DateTime t && t.Year > 2000)
                        .Select(d => d.LastConnOk!.Value)
                        .ToList();
                    if (stamps.Count > 0)
                        relLastChecked = stamps.Max();
                }
            }
            <div class="card-head">
                <h3>Relationships</h3>
                <div class="rel-head-side">
                    @if (relLastChecked is DateTime checkedAt)
                    {
                        <span class="rel-checked">Last checked: @checkedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    @if (Model.IsAdmin)
                    {
                        <details class="kebab">
                            <summary aria-label="Actions">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
                            </summary>
                            <div class="kebab-menu">
                                <button type="button" id="openAddRelationship">Add relationship</button>
                                @if (Model.Links.Count > 0)
                                {
                                    <button type="button" id="openEditRelationship">Edit relationship</button>
                                }
                            </div>
                        </details>
                    }
                </div>
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else if (Model.Links.Count == 0)
            {
                <p class="empty">No relationships yet.</p>
            }
            else
            {
                var masters = Model.Databases.Where(d => d.DbRole is "MASTER" or "BOTH").ToList();
                <div class="rel-list">
                @foreach (var m in masters)
                {
                    var masterLinks = Model.Links.Where(l => l.MasterDbId == m.DbId).ToList();
                    if (masterLinks.Count == 0) continue;
                    var onlineSubs = masterLinks.Count(l => Model.Databases.FirstOrDefault(d => d.DbId == l.SubDbId)?.ConnStatus == "ONLINE");
                    var masterOnline = m.ConnStatus == "ONLINE";
                    <section class="rel-group" data-rel-group>
                        <button type="button" class="rel-master" data-rel-toggle aria-expanded="true" aria-label="Expand or collapse @m.DisplayName">
                            <svg class="rel-chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <svg class="rel-db-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                            <span class="rel-name" title="@m.DisplayName">@m.DisplayName</span>
                            <span class="rel-role">MASTER</span>
                            <span class="rel-side">
                                <span class="rel-status @(masterOnline ? "is-online" : "is-offline")">
                                    <span class="rel-dot" aria-hidden="true"></span>
                                    @(masterOnline ? "Online" : m.ConnStatus)
                                </span>
                                <span class="rel-summary">@onlineSubs / @masterLinks.Count Online</span>
                            </span>
                        </button>
                        <div class="rel-subs">
                            @foreach (var link in masterLinks)
                            {
                                var sub = Model.Databases.FirstOrDefault(d => d.DbId == link.SubDbId);
                                var subOnline = sub?.ConnStatus == "ONLINE";
                                <div class="rel-sub">
                                    <svg class="rel-db-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                                    <span class="rel-role">SUB</span>
                                    <span class="rel-name" title="@link.SubName">@link.SubName</span>
                                    @if (sub is not null)
                                    {
                                        <span class="rel-status @(subOnline ? "is-online" : "is-offline")">
                                            <span class="rel-dot" aria-hidden="true"></span>
                                            @(subOnline ? "Online" : sub.ConnStatus)
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }
                </div>
                <script>
                    document.querySelectorAll("[data-rel-toggle]").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const group = btn.closest("[data-rel-group]");
                            const subs = group?.querySelector(".rel-subs");
                            const open = btn.getAttribute("aria-expanded") !== "false";
                            btn.setAttribute("aria-expanded", open ? "false" : "true");
                            group?.classList.toggle("is-collapsed", open);
                            if (subs) subs.hidden = open;
                        });
                    });
                </script>
            }
        </div>

        @if (Model.IsAdmin)
        {
            var linkMasters = Model.Databases.Where(d => d.DbRole is "MASTER" or "BOTH").ToList();
            var linkSubs = Model.Databases.Where(d => d.DbRole is "SUB" or "BOTH").ToList();
            var linkedSubIds = Model.Links.Select(l => l.SubDbId).ToHashSet();
            var availableSubs = linkSubs.Where(d => !linkedSubIds.Contains(d.DbId)).ToList();
            var linkError = TempData["LinkError"] as string;
            var planLinkedIds = string.Join(",", Model.Links
                .SelectMany(l => new[] { l.MasterDbId, l.SubDbId })
                .Where(id => Model.Databases.Any(d => d.DbId == id))
                .Distinct());
            <dialog id="addRelationshipDialog" class="accounts-modal" aria-labelledby="addRelationshipTitle">
                <form method="post" asp-page="/Databases/Link" class="accounts-modal-form" data-plan-cap="@Model.MaxDatabases" data-linked-ids="@planLinkedIds">
                    <input type="hidden" name="ReturnTo" value="dashboard" />
                    <div class="accounts-modal-head">
                        <h3 id="addRelationshipTitle">Add relationship</h3>
                        <button type="button" class="accounts-modal-close" data-add-relationship-close aria-label="Close">&times;</button>
                    </div>
                    <div class="accounts-modal-body">
                        @if (!string.IsNullOrWhiteSpace(linkError))
                        {
                            <div class="flash flash-err" data-link-error>@linkError</div>
                        }
                        @if (linkMasters.Count == 0 || linkSubs.Count == 0)
                        {
                            <p class="empty">Add at least one Master and one Sub before creating a relationship.</p>
                        }
                        else
                        {
                            <p class="field-hint">Choose a Master and one or more Subs. A company cannot be linked to itself.</p>
                            <p class="field-hint" data-plan-hint hidden>The plan allows @Model.MaxDatabases active databases.</p>
                            <div class="field">
                                <label for="dashLinkMaster">Master</label>
                                <select name="MasterDbId" id="dashLinkMaster" data-plan-master>
                                    @foreach (var d in linkMasters) { <option value="@d.DbId">@d.DisplayName (@d.DbRole)</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label>Sub</label>
                                @if (availableSubs.Count == 0)
                                {
                                    <p class="empty">Every Sub is already linked to a Master.</p>
                                }
                                else
                                {
                                    <div class="sub-multi">
                                        @foreach (var d in availableSubs)
                                        {
                                            <label class="sub-multi-row">
                                                <input type="checkbox" name="SubDbIds" value="@d.DbId" />
                                                <span>@d.DisplayName (@d.DbRole)</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="accounts-modal-actions">
                        <button type="button" class="btn btn-ghost" data-add-relationship-close>Cancel</button>
                        @if (linkMasters.Count > 0 && linkSubs.Count > 0 && availableSubs.Count > 0)
                        {
                            <button class="btn" type="submit">Save links</button>
                        }
                    </div>
                </form>
            </dialog>
            <script>
                function openAddRelationship() {
                    document.getElementById("openAddRelationship")?.closest("details.kebab")?.removeAttribute("open");
                    const dialog = document.getElementById("addRelationshipDialog");
                    if (dialog && typeof dialog.showModal === "function" && !dialog.open) dialog.showModal();
                }
                document.getElementById("openAddRelationship")?.addEventListener("click", openAddRelationship);
                document.querySelectorAll("[data-add-relationship-close]").forEach((btn) => {
                    btn.addEventListener("click", () => document.getElementById("addRelationshipDialog")?.close());
                });
                (function () {
                    const master = document.getElementById("dashLinkMaster");
                    if (!master) return;
                    function syncSubs() {
                        document.querySelectorAll("#addRelationshipDialog .sub-multi-row").forEach((row) => {
                            const box = row.querySelector("input");
                            const same = box && box.value === master.value;
                            row.hidden = !!same;
                            if (box && same) box.checked = false;
                        });
                    }
                    master.addEventListener("change", syncSubs);
                    syncSubs();
                })();
                if (document.querySelector("[data-link-error]")) openAddRelationship();
            </script>
            <dialog id="editRelationshipDialog" class="accounts-modal" aria-labelledby="editRelationshipTitle">
                <form method="post" asp-page="/Databases/Link" asp-page-handler="UpdateLinks" class="accounts-modal-form" id="editRelationshipForm">
                    <input type="hidden" name="ReturnTo" value="dashboard" />
                    <div class="accounts-modal-head">
                        <h3 id="editRelationshipTitle">Edit relationship</h3>
                        <button type="button" class="accounts-modal-close" data-edit-relationship-close aria-label="Close">&times;</button>
                    </div>
                    <div class="accounts-modal-body">
                        <p class="field-hint">Subs are listed under their master. Untick a sub, then press Update to unlink it. The company stays registered.</p>
                        <div class="rel-edit-list">
                            @foreach (var group in Model.Links.GroupBy(l => l.MasterDbId).OrderBy(g => g.First().MasterName))
                            {
                                <section class="rel-edit-group">
                                    <div class="rel-edit-master">
                                        <span class="rel-role">MASTER</span>
                                        <span>@group.First().MasterName</span>
                                    </div>
                                    @foreach (var link in group.OrderBy(l => l.SubName))
                                    {
                                        <label class="rel-edit-row">
                                            <input type="hidden" name="LinkIds" value="@link.LinkId" />
                                            <input type="checkbox" name="KeepLinkIds" value="@link.LinkId" checked
                                                   data-rel-keep data-rel-name="@($"{link.MasterName} → {link.SubName}")" />
                                            <span class="rel-role">SUB</span>
                                            <span>@link.SubName</span>
                                        </label>
                                    }
                                </section>
                            }
                        </div>
                    </div>
                    <div class="accounts-modal-actions">
                        <button type="button" class="btn btn-ghost" data-edit-relationship-close>Close</button>
                        <button class="btn" type="submit" id="updateRelationships"
                                data-confirm-title="Update relationships"
                                data-confirm-ok="Update"
                                data-confirm-danger>Update</button>
                    </div>
                </form>
            </dialog>
            <script>
                function openEditRelationship() {
                    document.getElementById("openEditRelationship")?.closest("details.kebab")?.removeAttribute("open");
                    const dialog = document.getElementById("editRelationshipDialog");
                    if (dialog && typeof dialog.showModal === "function" && !dialog.open) dialog.showModal();
                }
                document.getElementById("openEditRelationship")?.addEventListener("click", openEditRelationship);
                document.querySelectorAll("[data-edit-relationship-close]").forEach((btn) => {
                    btn.addEventListener("click", () => document.getElementById("editRelationshipDialog")?.close());
                });
                (function () {
                    const form = document.getElementById("editRelationshipForm");
                    const update = document.getElementById("updateRelationships");
                    if (!form || !update) return;
                    const boxes = () => Array.from(form.querySelectorAll("[data-rel-keep]"));
                    const refresh = () => {
                        const names = boxes().filter((box) => !box.checked).map((box) => box.getAttribute("data-rel-name"));
                        if (names.length === 0) update.removeAttribute("data-confirm");
                        else update.setAttribute("data-confirm", "Unlink " + names.join(", ") + "? The companies stay registered.");
                    };
                    form.addEventListener("change", refresh);
                    form.addEventListener("submit", (e) => {
                        if (boxes().some((box) => !box.checked)) return;
                        e.preventDefault();
                        document.getElementById("editRelationshipDialog")?.close();
                    });
                    refresh();
                })();
            </script>
        }

        <div class="card">
            <div class="card-head">
                <h3>Logs</h3>
                <a asp-page="/Logs">View</a>
            </div>
            @if (!Model.CentralConfigured)
            {
                <p class="empty">Central database is not configured.</p>
            }
            else if (Model.RecentTxns.Count == 0)
            {
                <p class="empty">No recent transactions.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>ID</th><th>Type</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.RecentTxns)
                        {
                            <tr>
                                <td><a asp-page="/Transactions/Details" asp-route-id="@t.TxnPk">@t.TxnId</a></td>
                                <td>@SyncDisplayNames.TxnType(t.TxnTypeCode)</td>
                                <td><span class="badge badge-@(t.Status.ToLowerInvariant())">@t.Status</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <h3>Settings</h3>
                <a asp-page="/Settings/Index">View</a>
            </div>
            <p class="muted">Central database: @(Model.CentralConfigured ? "Yes" : "No")</p>
            @if (Model.CentralConfigured)
            {
                <p class="muted">@Model.SettingsKeyCount setting key@(Model.SettingsKeyCount == 1 ? "" : "s")</p>
            }
            else
            {
                <p class="empty">Set CentralDb in .env / appsettings.</p>
            }
        </div>
    </div>
</div>
