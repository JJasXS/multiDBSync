# ProAcc / SqlAccountSync local env
TENANT_CODE=TNT10006
AWS_REGION=ap-southeast-1
TENANT_BOOTSTRAP_API_URL=https://v2wwsho311.execute-api.ap-southeast-1.amazonaws.com/default/proacc-tenant-config-api

# Required for Secrets Manager (SMTP OTP + SQL API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ASPNETCORE_ENVIRONMENT=Development

# Central Firebird control DB. Password ref defaults to env:CENTRAL_FB_MASTERKEY.
# Writes (schema, jobs, status) always use this database.
CentralDb__Path=C:/SQLData/SqlAccountSync/SYNC.FDB
CENTRAL_FB_MASTERKEY=masterkey

# Dashboard company registry. Local reads CentralDb. Live is SELECT-only against another SYNC.FDB.
# Set the Live host, port, and path in this file. Do not put them in appsettings.
# CentralRegistry__Mode=Local
# CentralRegistry__Host=
# CentralRegistry__Port=3050
# CentralRegistry__Path=
# CentralRegistry__User=SYSDBA
# CentralRegistry__PasswordSecretRef=env:CENTRAL_FB_MASTERKEY

# Optional local login FDB override (SY_USER). When Path is set, skips AWS tenant database.dbPath.
# Leave unset in production.
# LoginDb__Path=C:/eStream/SQLAccounting/DB/LOGIN.FDB
# LoginDb__Host=localhost
# LoginDb__Port=3050

# SQL Accounting write provider. Production appsettings keep Rest.
# Local Development uses appsettings.Development.json Provider=Sdk (do not put Sdk in Production).
# Override here only if needed:
# SqlAccountingWrite__Provider=Sdk
#
# SDK Live COM. Password via SecretResolver / env only — never commit secrets.
# appsettings.Development.json sets AllowLiveCom, DefaultDcfPath, UserName, PasswordSecretRef.
# Required for COM Login probe / writes in Development (Website /api/sdk/status → passwordConfigured).
# Set here OR as a User/process environment variable, then restart SqlAccountSync:
# SQLACC_SDK_PASSWORD=
#
# Development single-job process (workers stay off):
# Sync__AllowDevSingleJobProcess=true
# POST /api/dev/jobs/{jobId}/process  (Admin; MIRACLE/ONYAT dest only)
#
# Keep background write workers off during local SDK verification (also set in Development json):
# Sync__EnableBackgroundWriteWorkers=false
# Sync__AccountAutoPushSeconds=0

# Login admin
Bootstrap__AdminEmail=jason.choo2004@gmail.com
Bootstrap__AdminName=Jason Choo
