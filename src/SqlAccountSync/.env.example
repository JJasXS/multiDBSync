# Copy to .env in the project or content-root folder. Never commit .env.

ASPNETCORE_ENVIRONMENT=Development

# Central Firebird control database (orchestration store — not a SQL Account company DB)
CentralDb__Host=localhost
CentralDb__Port=3050
CentralDb__Path=C:/SQLData/SqlAccountSync/SYNC.FDB
CentralDb__User=SYSDBA
CentralDb__Charset=UTF8
CentralDb__Dialect=3

# Password via secret reference (never stored in SYNC_DATABASE rows)
# env:VARNAME  |  sm:secret-id  |  dpapi:relative-file-name
# Set CENTRAL_FB_PASSWORD to the Firebird SYSDBA password (local default is often masterkey).
CentralDb__PasswordSecretRef=env:CENTRAL_FB_PASSWORD
CENTRAL_FB_PASSWORD=

# SMTP for OTP login
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__PasswordSecretRef=env:SMTP_PASSWORD
Smtp__From=

# AWS (optional — used when secret refs start with sm:)
AWS__Region=ap-southeast-1

# Safety: refuse PRODUCTION SQL Account DBs unless explicitly allowed
Sync__AllowProductionConnections=false
Sync__AllowCrossEnvironment=false

# Bootstrap first admin (OTP-only; no stored password)
Bootstrap__AdminEmail=admin@localhost
Bootstrap__AdminName=Administrator
