# ProAcc / SqlAccountSync local env — copy to .env (never commit .env)
TENANT_CODE=TNT10006
AWS_REGION=ap-southeast-1
TENANT_BOOTSTRAP_API_URL=https://v2wwsho311.execute-api.ap-southeast-1.amazonaws.com/default/proacc-tenant-config-api

# Required for Secrets Manager (SMTP OTP + SDK connections)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override; default is proacc/tenant/{TENANT_CODE}/sdkConnections
# SDK_SECRET_ID=

ASPNETCORE_ENVIRONMENT=Development

# Login OTP behaviour:
#   APP_MODE=prod → email OTP only (required for any publicly reachable host)
#   APP_MODE=dev + ASPNETCORE_ENVIRONMENT=Development + Sync__AllowLocalOtpReveal=true
#     → OTP may appear in the login JSON only for loopback clients (never set on public hosts)
APP_MODE=dev
# Sync__AllowLocalOtpReveal=true
# Shared HMAC pepper for OTP hashes (multi-instance). Example: env:OTP_HMAC_PEPPER
# Sync__OtpHashPepperSecretRef=env:OTP_HMAC_PEPPER
# Production host filter (semicolon-separated). Required when ASPNETCORE_ENVIRONMENT=Production.
# Private LAN IPs + machine name are auto-added at startup (no need to hardcode 192.168.x.x).
# Opt out: HostHardening__IncludeLanAddresses=false
# AllowedHosts=sync.example.com
# Trusted reverse proxy (optional):
# ForwardedHeaders__KnownProxies__0=10.0.0.1
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8

# Central Firebird control DB. Password ref defaults to env:CENTRAL_FB_MASTERKEY.
# Writes (schema, jobs, status) always use this database.
CentralDb__Path=C:/SQLData/SqlAccountSync/SYNC.FDB
# Never use Firebird default "masterkey" in real environments.
CENTRAL_FB_MASTERKEY=REPLACE_WITH_STRONG_PASSWORD

# Dashboard company registry. Local reads CentralDb. Live is SELECT-only against another SYNC.FDB.
# CentralRegistry__Mode=Local
# CentralRegistry__Host=
# CentralRegistry__Port=3050
# CentralRegistry__Path=
# Prefer a dedicated app user over SYSDBA when possible.
# CentralRegistry__User=SYNC_APP
# CentralRegistry__PasswordSecretRef=env:CENTRAL_FB_MASTERKEY

# Optional local login FDB override (SY_USER). When Path is set, skips AWS tenant database.dbPath.
# Leave unset in production.
# LoginDb__Path=C:/eStream/SQLAccounting/DB/LOGIN.FDB
# LoginDb__Host=localhost
# LoginDb__Port=3050

# SQL Accounting write provider. Production appsettings keep Rest.
# Local Development may set Provider=Sdk in appsettings.Development.json (do not commit live COM secrets).
# Override here only if needed:
# SqlAccountingWrite__Provider=Sdk
#
# SDK Live COM (YHang). Password via SecretResolver / env only — never commit secrets.
# SQLACC_SDK_PASSWORD=
#
# Development single-job process (workers stay off):
# Sync__AllowDevSingleJobProcess=true
# Keep background write workers off during local SDK verification:
# Sync__EnableBackgroundWriteWorkers=false
# Sync__AccountAutoPushSeconds=0

# Login admin (seed / bootstrap email — not a secret)
# Optional: seed / login hint only. Leave empty — do not use admin@localhost.
# Bootstrap__AdminEmail=
# Bootstrap__AdminName=Administrator
