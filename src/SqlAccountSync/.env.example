# ProAcc / SqlAccountSync local env — copy to .env (never commit .env)
TENANT_CODE=TNT10006
AWS_REGION=ap-southeast-1
TENANT_BOOTSTRAP_API_URL=https://v2wwsho311.execute-api.ap-southeast-1.amazonaws.com/default/proacc-tenant-config-api

# Required for Secrets Manager (SMTP OTP + SDK connections)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override; default is proacc/tenant/{TENANT_CODE}/sdkConnections
# SDK_SECRET_ID=

ASPNETCORE_ENVIRONMENT=Development

# Login OTP behaviour (independent of ASPNETCORE_ENVIRONMENT):
#   APP_MODE=dev  → may show OTP on the login page ONLY when ASPNETCORE_ENVIRONMENT=Development
#   APP_MODE=prod → email OTP only (required for any publicly reachable host)
APP_MODE=dev

# Central Firebird control DB. Password ref defaults to env:CENTRAL_FB_MASTERKEY.
# Writes (schema, jobs, status) always use this database.
CentralDb__Path=C:/SQLData/SqlAccountSync/SYNC.FDB
# Never use Firebird default "masterkey" in real environments.
CENTRAL_FB_MASTERKEY=REPLACE_WITH_STRONG_PASSWORD

# Dashboard company registry. Local reads CentralDb. Live is SELECT-only against another SYNC.FDB.
# CentralRegistry__Mode=Local
# CentralRegistry__Host=
# CentralRegistry__Port=3050
# CentralRegistry__Path=
# Prefer a dedicated app user over SYSDBA when possible.
# CentralRegistry__User=SYNC_APP
# CentralRegistry__PasswordSecretRef=env:CENTRAL_FB_MASTERKEY

# Login admin (seed / bootstrap email — not a secret)
Bootstrap__AdminEmail=admin@localhost
Bootstrap__AdminName=Administrator
